---
import AppShell from '@/components/layout/AppShell.astro';
import AdminPage from '@/components/pages/AdminPage.astro';
import { useTranslations } from '@/i18n';
import { loginPathFor } from '@/lib/locale';
import { loadOperations } from '@/lib/operations';
import { readSession } from '@/lib/session';
import { loadStatus } from '@/lib/status';

export const prerender = false;

const session = readSession(Astro.request);
if (!session.identity) return Astro.redirect(loginPathFor(Astro.url.pathname));

// Angemeldet, aber nicht berechtigt: die Antwort sagt das auch im Status.
if (!session.isAdmin) Astro.response.status = 403;

// Die Betriebsansicht liest ihre Quellen selbst; fehlt eine, sagt sie das.
const snapshot = await loadStatus(session.services.map((service) => service.id));
const operations = loadOperations();
const t = useTranslations('de');
---

<AppShell locale="de" session={session} title={t('adminTitle')} description={t('adminIntro')}>
  <AdminPage locale="de" session={session} snapshot={snapshot} operations={operations} />
</AppShell>
