---
import Layout from '../../layouts/Layout.astro';
import AppShell from '../../components/shell/AppShell.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<Layout locale="en">
  <AppShell locale="en">
    <div class="alert max-w-lg">
      <div>
        <h1 class="text-lg font-semibold">{t.notFound}</h1>
        <p class="text-sm opacity-70">{t.siteDesc}</p>
        <div class="mt-3"><a class="btn btn-primary btn-sm" href="/en/">{t.navOverview}</a></div>
      </div>
    </div>
  </AppShell>
</Layout>
