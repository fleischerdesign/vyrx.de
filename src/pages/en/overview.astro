---
import AppShell from '@/components/layout/AppShell.astro';
import Overview from '@/components/workspace/Overview.astro';
import { useTranslations } from '@/i18n';
import { loginPathFor, pathFor } from '@/lib/locale';
import { readSession } from '@/lib/session';

export const prerender = false;

const session = readSession(Astro.request);
if (!session.identity) return Astro.redirect(loginPathFor(pathFor('en', 'overview')));

const t = useTranslations('en');
---

<AppShell locale="en" session={session} title={t('navOverview')} description={t('overviewIntro')}>
  <Overview locale="en" session={session} />
</AppShell>
