---
import AppShell from '@/components/layout/AppShell.astro';
import AccountPage from '@/components/pages/AccountPage.astro';
import { useTranslations } from '@/i18n';
import { loginPathFor } from '@/lib/locale';
import { readSession } from '@/lib/session';

export const prerender = false;

const session = readSession(Astro.request);
if (!session.identity) return Astro.redirect(loginPathFor(Astro.url.pathname));

const t = useTranslations('en');
---

<AppShell locale="en" session={session} title={t('accountTitle')} description={t('accountIntro')}>
  <AccountPage locale="en" session={session} />
</AppShell>
