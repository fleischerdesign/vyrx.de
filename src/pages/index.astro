---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n';
import meshData from '../data/mesh.json';
import appsData from '../data/apps.json';

const locale = 'de';
const t = useTranslations(locale);
---

<Layout locale={locale}>
  <div class="container">
    <!-- Navbar -->
    <header>
      <a href="/" class="brand">
        <div class="brand-logo">
          <span>VYRX</span>
          <span class="brand-dot"></span>
        </div>
      </a>

      <div class="header-actions">
        <!-- Language Switcher -->
        <div class="lang-switcher">
          <a href="/" class="lang-btn active">DE</a>
          <a href="/en/" class="lang-btn">EN</a>
        </div>

        <div class="mesh-badge">
          <span class="live-dot"></span>
          <span id="mesh-status-text">MESH 10.10.100.0/24</span>
        </div>

        <!-- Default: Login Button -->
        <a href="https://auth.vyrx.de" class="btn-login" id="login-action-btn">
          <span>{t.workspaceLogin}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>

        <!-- Authenticated State: User Pill (populated client-side without layout shift) -->
        <div class="user-pill" id="user-profile-pill">
          <div class="user-avatar" id="user-avatar-initial">U</div>
          <span class="user-name" id="user-display-name">User</span>
          <a href="https://auth.vyrx.de/flows/-/default/invalidation/" class="user-logout" title={t.logout}>✕</a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <main class="hero">
      <div class="hero-eyebrow">
        <span>{t.eyebrow}</span>
      </div>

      <h1>{t.heroTitlePrefix}<br>{t.heroTitleSuffix}</h1>

      <p class="hero-p">
        {t.heroDescription}
      </p>

      <div class="hero-actions">
        <a href="https://auth.vyrx.de" class="btn-primary">
          <span>{t.openWorkspace}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <div class="auth-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>{t.authProtection}</span>
        </div>
      </div>
    </main>

    <!-- 1. Infrastructure & Mesh Nodes -->
    <div class="section-header">
      <div>
        <div class="section-title">
          <span>{t.meshSectionTitle}</span>
        </div>
        <div class="section-desc">{t.meshSectionDesc}</div>
      </div>
    </div>

    <div class="mesh-monitor">
      <table class="monitor-table">
        <thead>
          <tr>
            <th>{t.tableColHost}</th>
            <th>{t.tableColZone}</th>
            <th>{t.tableColAddress}</th>
            <th>{t.tableColServices}</th>
          </tr>
        </thead>
        <tbody>
          {meshData.nodes.map((node) => (
            <tr class="monitor-row">
              <td>
                <div class="node-ident">
                  <div class="node-status-pulse pulse-online" title="Online / Active"></div>
                  <div class="node-title-group">
                    <div class="node-hostname">
                      <span>{node.name}</span>
                      <span class="node-zone-tag">{node.hardware}</span>
                    </div>
                    <div class="node-role-desc">{node.role[locale]}</div>
                  </div>
                </div>
              </td>
              <td>
                <div class="node-hardware">{node.zone}</div>
              </td>
              <td>
                <span class="node-ip-badge">{node.address}</span>
              </td>
              <td>
                <div class="node-stack-pills">
                  {node.services.map((svc) => (
                    <span class="stack-pill">{svc}</span>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 2. Family & Infrastructure Applications -->
    <div class="section-header">
      <div>
        <div class="section-title">
          <span>{t.appsSectionTitle}</span>
        </div>
        <div class="section-desc">{t.appsSectionDesc}</div>
      </div>
    </div>

    <section class="app-grid">
      {appsData.map((app) => {
        const isRestricted = app.requiredGroups.includes('wheel') && !app.requiredGroups.includes('family');
        return (
          <a
            href={app.url}
            class="app-card"
            data-required-group={isRestricted ? "wheel" : undefined}
            style={isRestricted ? "display: none;" : undefined}
          >
            <div>
              <div class="app-top">
                <div class="app-icon">
                  {app.icon === 'media' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                  )}
                  {app.icon === 'document' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  )}
                  {app.icon === 'check' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                  )}
                  {app.icon === 'cpu' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  )}
                  {app.icon === 'chart' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                  )}
                  {app.icon === 'home' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                  )}
                </div>
                <span class="app-badge">{app.badge[locale]}</span>
              </div>
              <div class="app-title">{app.name}</div>
              <div class="app-desc">{app.desc[locale]}</div>
            </div>
            <div class="app-footer">
              <span class="app-url">{app.url.replace('https://', '')}</span>
              <span class="app-action">{t.launchApp} →</span>
            </div>
          </a>
        );
      })}
    </section>

    <!-- Footer -->
    <footer>
      <div>
        {t.footerPlatform}
      </div>
      <div class="footer-links">
        <a href="https://github.com/fleischerdesign/nixfiles" target="_blank" rel="noreferrer">{t.gitopsFlake}</a>
        <a href="/.well-known/security.txt">{t.securityPolicy}</a>
        <a href="https://auth.vyrx.de">{t.ssoPortal}</a>
      </div>
    </footer>
  </div>
</Layout>
