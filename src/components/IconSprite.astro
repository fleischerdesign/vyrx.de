---
// The sprite: one `<symbol>` per declared icon, read from `src/icons/` and inlined into the document.
//
// The icons are vendored instead of imported from a package, because the geometry has to be inlined at
// build time and the previous approach read it through a filesystem path computed from `import.meta.url`.
// That worked only by accident: since Astro 6 bundles server code, the module no longer lives next to its
// source, so `../../node_modules/...` resolved into `dist/`. A glob is resolved by the bundler and works
// wherever the module ends up.
//
// Vendoring also removes the npm dependency whose hash had to be maintained, and it puts the geometry in
// the tree where it can be reviewed. Lucide is ISC; the notice travels inside each file.
import { ICONS } from '../lib/icons.js';

const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

// Only the geometry: size, colour and stroke live in `icon()`, so an icon cannot be rendered differently
// depending on which renderer asked for it.
const geometry = (name) => {
  const raw = files[`../icons/${name}.svg`];
  if (typeof raw !== 'string') {
    throw new Error(`src/icons/${name}.svg is missing - declared in src/lib/icons.js, absent from the tree`);
  }
  const body = raw
    .replace(/^[\s\S]*?<svg[^>]*>/, '')
    .replace(/<\/svg>[\s\S]*$/, '')
    .trim();
  if (!body) throw new Error(`src/icons/${name}.svg carried no geometry`);
  return body;
};

// The other direction as well: a file nobody declares is either a leftover or a forgotten entry, and both
// are silent. `ICONS` is the declaration, the directory is the fact, and they have to agree.
const undeclared = Object.keys(files)
  .map((path) => path.replace('../icons/', '').replace(/\.svg$/, ''))
  .filter((name) => !ICONS.includes(name));
if (undeclared.length) {
  throw new Error(`src/icons/${undeclared.join('.svg, src/icons/')}.svg is not declared in src/lib/icons.js`);
}

const symbols = ICONS.map((name) => ({ name, body: geometry(name) }));
---

<svg class="hidden" aria-hidden="true" data-icon-sprite>
  {
    symbols.map(({ name, body }) => (
      <symbol id={`i-${name}`} viewBox="0 0 24 24" set:html={body} />
    ))
  }
</svg>
