---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/ui/Button.astro';
import { useTranslations } from '@/i18n';
import { loginPathFor, pathFor, type Locale } from '@/lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = [
  { overline: t('helpStep1Overline'), title: t('helpStep1Title'), text: t('helpStep1Text') },
  { overline: t('helpStep2Overline'), title: t('helpStep2Title'), text: t('helpStep2Text') },
  { overline: t('helpStep3Overline'), title: t('helpStep3Title'), text: t('helpStep3Text') },
];

const faq = [
  { q: t('helpFaq1Q'), a: t('helpFaq1A') },
  { q: t('helpFaq2Q'), a: t('helpFaq2A') },
  { q: t('helpFaq3Q'), a: t('helpFaq3A') },
];
---

<PublicLayout locale={locale} title={t('helpTitle')} description={t('helpIntro')}>
  <article class="container page">
    <header class="head">
      <p class="kicker">{t('helpEyebrow')}</p>
      <h1>{t('helpTitle')}</h1>
      <p class="head__lead">{t('helpIntro')}</p>
    </header>

    <div class="steps">
      {
        steps.map((step) => (
          <section class="step">
            <p class="step__number">{step.overline}</p>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </section>
        ))
      }
    </div>

    <section class="faq">
      <h2>{t('helpFaqTitle')}</h2>
      {
        faq.map((entry) => (
          <details>
            <summary>{entry.q}</summary>
            <p>{entry.a}</p>
          </details>
        ))
      }
    </section>

    <div class="cta">
      <Button href={loginPathFor(pathFor(locale, 'start'))} variant="primary" icon="arrowRight">
        {t('openWorkspace')}
      </Button>
      <Button href={pathFor(locale, 'start')} variant="quiet">{t('notFoundAction')}</Button>
    </div>
  </article>
</PublicLayout>

<style>
  .page {
    padding-block: clamp(var(--space-12), 7vw, var(--space-20));
  }

  .head {
    max-width: 60rem;
    margin-bottom: var(--space-12);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: var(--space-4);
  }

  .head h1 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-5);
  }

  .head__lead {
    color: var(--muted);
    font-size: var(--text-md);
    max-width: var(--measure);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-16);
  }

  .step {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .step__number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-strong);
  }

  .step h2 {
    font-size: var(--text-base);
    margin: var(--space-5) 0 var(--space-3);
  }

  .step p:last-child {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .faq {
    max-width: 55rem;
  }

  .faq h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-5);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq details:first-of-type {
    border-top: 1px solid var(--line);
  }

  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    color: var(--accent);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .faq details[open] summary::after {
    content: '−';
  }

  .faq details p {
    color: var(--muted);
    font-size: var(--text-sm);
    padding-bottom: var(--space-5);
    max-width: var(--measure);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-12);
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
