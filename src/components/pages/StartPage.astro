---
/*
 * Der öffentliche Einstieg.
 *
 * Diese Seite liest **keine** Identität: sie ist für alle gleich und wird als
 * Datei gebaut. Genau deshalb darf sie an der Anmeldung vorbeilaufen. Der
 * Workspace beginnt unter `/overview/`, wo der Proxy die Identität liefert.
 */
import PublicLayout from '@/layouts/PublicLayout.astro';
import Landing from '@/components/landing/Landing.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<PublicLayout locale={locale} title={t('siteTitle')} description={t('siteDescription')}>
  <Landing locale={locale} />
</PublicLayout>
