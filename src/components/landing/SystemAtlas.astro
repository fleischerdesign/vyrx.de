---
/*
 * Der System-Atlas: eine redaktionelle Landschaft der Grundstruktur aus Home,
 * zwei Cloud-Hosts, mobilen Geräten und dem verbindenden Mesh. Er ist eine
 * Zeichnung - kein Netzplan, keine Topologie und kein Live-Zustand. Die
 * Bildunterschrift sagt das ausdrücklich.
 */
import { useTranslations } from '@/i18n';
import type { Locale } from '@/lib/locale';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  locale: Locale;
  projectHref: string;
}

const { locale, projectHref } = Astro.props;
const t = useTranslations(locale);
---

<figure class="atlas">
  <div class="atlas__head">
    <span>{t('atlasLabel')}</span>
    <span>{t('atlasScope')}</span>
  </div>

  <svg
    class="atlas__map"
    viewBox="0 0 520 420"
    role="img"
    aria-label={`${t('atlasAlt')}. ${t('atlasNote')}.`}
  >
    <defs>
      <linearGradient id="atlas-ground" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#33314e"></stop><stop offset="1" stop-color="#242335"></stop>
      </linearGradient>
      <linearGradient id="atlas-cloud-top" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#eeebfa"></stop><stop offset="1" stop-color="#bcb8d5"></stop>
      </linearGradient>
      <linearGradient id="atlas-home-top" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#c3bddc"></stop><stop offset="1" stop-color="#928ba9"></stop>
      </linearGradient>
      <pattern id="atlas-mesh" width="40" height="20" patternUnits="userSpaceOnUse">
        <path d="M0 0 40 20M0 20 40 0" fill="none" stroke="#a599d6" stroke-opacity=".12" stroke-width=".6"></path>
      </pattern>
      <g id="atlas-cloud-host">
        <path class="contact" d="m-35 0 35-18 44 22-35 18Z"></path>
        <path d="m-30-72 30 15V15L-30 0Z" fill="#9288b1"></path>
        <path d="m0-57 30-15V0L0 15Z" fill="#5f567d"></path>
        <path d="m-30-72 30-15 30 15-30 15Z" fill="url(#atlas-cloud-top)" stroke="#e4dff4" stroke-width=".8"></path>
        <path d="m-23-72 23-11.5 23 11.5L0-60.5Z" fill="none" stroke="#9f96b9"></path>
        <path class="detail" d="m-30-52 30 15 30-15m-60 20L0-17l30-15m-60 20L0 3l30-15"></path>
        <path d="m-22-43 13 6.5m-13 13.5 13 6.5m-13 13.5L-9 3.5" stroke="#d9d1ed" stroke-width="2"></path>
        <path d="M0-57V15" stroke="#c6b8e9" stroke-opacity=".5"></path>
      </g>
      <g id="atlas-device">
        <path class="contact" d="m-12 0 15-7.5 17 8.5L5 8.5Z"></path>
        <path d="m-12-10 12 6V6l-12-6Z" fill="#7e768f"></path>
        <path d="m0-4 16-8V-2L0 6Z" fill="#504a63"></path>
        <path d="m-12-10 16-8 12 6-16 8Z" fill="url(#atlas-home-top)"></path>
      </g>
    </defs>

    <g stroke="#555066" fill="none"><path d="M25 60V48h12M483 48h12v12M25 378v12h12M483 390h12v-12"></path></g>

    <path d="m30 253 230-115 230 115-230 115Z" fill="#10121c"></path>
    <path d="m30 245 230-115 230 115-230 115Z" fill="url(#atlas-ground)" stroke="#69617f"></path>
    <path d="m30 245 230-115 230 115-230 115Z" fill="url(#atlas-mesh)"></path>
    <path d="m30 245 230 115v8L30 253Z" fill="#39324d"></path>
    <path d="m260 360 230-115v8L260 368Z" fill="#252135"></path>
    <path d="m30 245 230 115 230-115" fill="none" stroke="#9d8cc7" stroke-opacity=".5"></path>

    <g fill="none" stroke="#a68aef" stroke-linejoin="round">
      <path d="m259 177 80 40-80 40-80-40-49 24m209-24-80 40 78 39M259 177l-80 40" stroke-width="9" opacity=".08"></path>
      <path d="m259 177 80 40-80 40-80-40-49 24m209-24-80 40 78 39M259 177l-80 40" stroke-width="1.5" opacity=".8"></path>
      <path d="m253 180 80 40-74 37m-86-37-37 18m129 22 66 33" stroke-width=".7" opacity=".5"></path>
    </g>
    <path d="m95 246 67-33 59 29-67 34 42 21m-42-21-20 10" fill="none" stroke="#b1a4ca" stroke-opacity=".4"></path>

    <use href="#atlas-cloud-host" transform="translate(259 177)"></use>
    <use href="#atlas-cloud-host" transform="translate(339 217)"></use>

    <g transform="translate(147 245)">
      <path class="contact" d="m-27 0 32-16 34 17-32 16Z"></path>
      <path d="m-25-42 30 15V15L-25 0Z" fill="#9487ac"></path>
      <path d="m5-27 28-14V1L5 15Z" fill="#5d506f"></path>
      <path d="m-25-42 28-14 30 15-28 14Z" fill="url(#atlas-home-top)" stroke="#c9bddc" stroke-width=".8"></path>
      <path class="detail" d="m-25-27 30 15 28-14m-58 28 30 15 28-14"></path>
      <path d="m-17-22 14 7m-14 7 14 7" stroke="#ddd3ec" stroke-width="2"></path>
    </g>

    <use href="#atlas-device" transform="translate(99 250)"></use>
    <path d="M93 237v-19m10 14v-19" stroke="#c2b5d6" stroke-width="2"></path>
    <use href="#atlas-device" transform="translate(123 279)"></use>
    <use href="#atlas-device" transform="translate(150 293)"></use>
    <path d="m119 265 9-4.5m18 19 9-4.5" stroke="#e0d4ee" stroke-width="2"></path>

    <g transform="translate(206 294)">
      <path class="contact" d="m-24 0 18-9 30 15-18 9Z"></path>
      <path d="m-20-2 10-5 25 12-10 5Z" fill="#7e7298"></path>
      <path d="M-3-20V1l7 3v-21" fill="#a59aba"></path>
      <path d="m-27-56 54 27v35L-27-21Z" fill="#b4a6ca"></path>
      <path d="m-23-50 46 23v26l-46-23Z" fill="#29273c"></path>
      <path d="m-18-42 16 8m-16-1 28 14m-28-7 21 10" stroke="#9e87d2" stroke-width="1.4"></path>
    </g>

    <g transform="translate(337 302)">
      <path class="contact" d="m-35 0 28-14 45 22-28 14Z"></path>
      <path d="m-34-5 28-14 40 20-28 14Z" fill="#9b88bf" stroke="#c6b4e4"></path>
      <path d="m-34-5 40 20v3L-34-2Z" fill="#6d5b8e"></path>
      <path d="m-34-5-5-34 40 20 5 34Z" fill="#b7a1d8"></path>
      <path d="m-30-8-4-24L-3-16 1 8Z" fill="#302940"></path>
      <path d="m-1 3 9-4.5 17 8.5-9 4.5Z" fill="none" stroke="#5d4d79"></path>
    </g>

    <path d="M74 187v19l29 14M383 103v66l-14 7m-9 140 21 11v23" fill="none" stroke="#8e809f" stroke-opacity=".6"></path>

    <text x="35" y="154">{t('atlasHome')}</text>
    <text class="small" x="35" y="175">{t('atlasHomeNote')}</text>
    <text x="352" y="66">{t('atlasCloud')}</text>
    <text class="small" x="352" y="87">{t('atlasCloudNote')}</text>
    <text x="333" y="377">{t('atlasRoaming')}</text>
    <path d="M56 341h22" stroke="#b298ef" stroke-width="2"></path>
    <text class="mesh" x="56" y="363">{t('atlasMeshLabel')}</text>
    <text class="small" x="56" y="383">{t('atlasMeshNote')}</text>
  </svg>

  <figcaption class="atlas__caption">
    <div>
      <strong>{t('atlasTagline')}</strong>
      <small>{t('atlasNote')}</small>
    </div>
    <a class="atlas__link" href={projectHref}>
      {t('atlasProject')}
      <Icon name="arrowRight" size="0.95rem" />
    </a>
  </figcaption>
</figure>

<style>
  .atlas {
    margin: 0;
    min-width: 0;
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 55% 36%, #29263e 0, transparent 65%),
      var(--panel-2);
    color: var(--panel-ink);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .atlas__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-6) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    color: #c4c0d7;
  }

  .atlas__head span:last-child {
    color: #a9a1ca;
    letter-spacing: var(--tracking-wide);
  }

  .atlas__map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .atlas__map text {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.025em;
    fill: #f1effa;
  }

  .atlas__map .small {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: var(--weight-regular);
    letter-spacing: 0.015em;
    fill: #b8b2ce;
  }

  .atlas__map .mesh {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.07em;
    fill: var(--panel-accent);
  }

  .atlas__map .contact {
    fill: #10111d;
    opacity: 0.65;
  }

  .atlas__map .detail {
    fill: none;
    stroke: #ded8f1;
    stroke-width: 1;
    stroke-opacity: 0.45;
  }

  .atlas__caption {
    position: relative;
    margin: 0 var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid #3b3b50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .atlas__caption strong {
    display: block;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
  }

  .atlas__caption small {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--panel-muted);
  }

  .atlas__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
    font-size: var(--text-xs);
    color: #e4dcff;
    padding: var(--space-2) 0;
    text-decoration: underline;
    text-decoration-color: #71668e;
    text-underline-offset: 5px;
  }

  .atlas__link:hover {
    text-decoration-color: #e4dcff;
  }

  @media (max-width: 760px) {
    .atlas__map text {
      font-size: 23px;
    }

    .atlas__map .small {
      font-size: 16px;
    }

    .atlas__map .mesh {
      font-size: 15px;
    }

    .atlas__caption {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
