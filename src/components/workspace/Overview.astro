---
import AssistantPrompt from '@/components/assistant/AssistantPrompt.astro';
import ServiceRow from '@/components/services/ServiceRow.astro';
import Onboarding from '@/components/onboarding/Onboarding.astro';
import ForYou from '@/components/workspace/ForYou.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { pathFor, type Locale } from '@/lib/locale';
import type { Session } from '@/lib/session';
import { favoritesOf, mediaWatchesOf, notificationPreferencesOf, onboardingStateOf, routineStateOf } from '@/lib/store';
import { ROUTINES } from '@/lib/routines/index.ts';
import { nextRoutineRun } from '@/lib/routines/schedule.ts';
import { loadStatus, stateOf } from '@/lib/status';
import { activeAnnouncements, announcementText } from '@/lib/announcements';

interface Props {
  locale: Locale;
  session: Session;
  legacyOnboarded: boolean;
}

const { locale, session, legacyOnboarded } = Astro.props;
const t = useTranslations(locale);
const name = session.identity?.name || session.identity?.username || '';
const owner = session.identity?.username ?? '';
const services = session.services;
const favorites = owner ? favoritesOf(owner) : [];
const saved = services.filter((service) => favorites.includes(service.id));
const shown = saved.length > 0 ? saved : services;
const news = session.identity ? activeAnnouncements(session.identity.groups) : [];
const onboardingState = owner ? onboardingStateOf(owner) : null;
const showForYou = legacyOnboarded || Boolean(onboardingState?.completedAt || onboardingState?.dismissedAt);
const watches = owner ? mediaWatchesOf(owner) : [];
const availableSince = Date.now() - 21 * 86_400_000;
const available = watches.filter((watch) => {
  const changed = Date.parse(watch.updatedAt);
  return watch.lastStatus === 'available' && Number.isFinite(changed) && changed >= availableSince;
}).length;
const openRequests = watches.filter(
  (watch) =>
    watch.active &&
    watch.lastStatus !== 'available' &&
    watch.lastStatus !== 'declined' &&
    watch.lastStatus !== 'failed' &&
    watch.lastStatus !== 'blocklisted',
).length;
const now = new Date();
const nextRoutine = showForYou && owner
  ? ROUTINES.map((routine) => {
      const state = routineStateOf(owner, routine.id);
      const at = state ? new Date(state.nextRunAt) : nextRoutineRun(routine.schedule, now);
      return Number.isFinite(at.getTime()) ? { title: routine.title, at: at.toISOString() } : null;
    })
      .filter((entry): entry is { title: string; at: string } => entry !== null)
      .sort((a, b) => Date.parse(a.at) - Date.parse(b.at))[0] ?? null
  : null;
const statusSnapshot = showForYou
  ? await Promise.race([
      loadStatus(services.map((service) => service.id)),
      new Promise<null>((resolve) => setTimeout(() => resolve(null), 300)),
    ])
  : null;
const degraded = statusSnapshot ? services.filter((service) => stateOf(service, statusSnapshot).state === 'down').length : 0;
const notificationPreferences = owner
  ? notificationPreferencesOf(owner)
  : { push: true, quietStart: null, quietEnd: null, request: true, routine: true };
---

<PageHeader
  overline={t('overviewEyebrow')}
  title={t('overviewGreeting', { name })}
  description={t('overviewIntro')}
/>

<Onboarding
  locale={locale}
  services={services}
  favorites={favorites}
  state={onboardingState}
  legacyOnboarded={legacyOnboarded}
  name={name}
  preferences={notificationPreferences}
/>

{showForYou && (
  <ForYou
    locale={locale}
    openRequests={openRequests}
    available={available}
    nextRoutine={nextRoutine}
    degraded={degraded}
    statusKnown={Boolean(statusSnapshot)}
  />
)}

<AssistantPrompt
  locale={locale}
  examples={[t('assistantSuggestOverview1'), t('assistantSuggestOverview2')]}
/>

{
  news.length > 0 && (
    <section class="news" aria-label={t('newsTitle')}>
      {news.map((entry) => (
        <div class="news__item">
          <Icon name="bell" size="1rem" />
          <p>
            {announcementText(entry, locale)}
            {entry.href && entry.hrefLabel && (
              <>
                {' '}
                <a href={entry.href}>{entry.hrefLabel[locale] || entry.hrefLabel.de}</a>
              </>
            )}
          </p>
        </div>
      ))}
    </section>
  )
}

<section class="block">
  <div class="block__head">
    <h2>{saved.length > 0 ? t('favoritesTitle') : t('overviewRecent')}</h2>
    <a href={pathFor(locale, 'services')}>{t('overviewAllServices')} →</a>
  </div>
  {saved.length === 0 && <p class="hint">{t('favoritesEmpty')}</p>}

  {
    services.length === 0 ? (
      <EmptyState title={t('overviewEmpty')} text={t('overviewEmptyHint')} icon="lock" />
    ) : (
      <div class="rows">
        {shown.map((service) => (
          <ServiceRow service={service} locale={locale} favorited={favorites.includes(service.id)} />
        ))}
      </div>
    )
  }
</section>


<style>
  .block + .block {
    margin-top: var(--space-12);
  }

  .news {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .news__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--accent-strong);
  }

  .news__item p {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .news__item a {
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .block__head h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .block__head a {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--accent);
  }

  .rows {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
  }

  .hint {
    color: var(--muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 620px) {
    .hint {
      margin-bottom: var(--space-3);
    }
  }
</style>
