---
/*
 * Ein kontextueller Einstieg: „Frag zu diesem Dienst". Der Klick wird von der
 * Assistenten-Komponente abgefangen; diese Datei braucht kein eigenes Skript.
 */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  readonly label: string;
  readonly query: string;
}

const { label, query } = Astro.props;
---

<button type="button" class="ask-link" data-assistant-open data-assistant-query={query} hidden>
  <Icon name="sparkles" size="0.95rem" />
  <span>{label}</span>
</button>

<style>
  .ask-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .ask-link :global(svg) {
    color: var(--accent);
    flex: none;
  }

  .ask-link:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-weaker);
    color: var(--accent-strong);
  }

  @media (pointer: coarse) {
    .ask-link {
      min-height: 2.75rem;
    }
  }
</style>
