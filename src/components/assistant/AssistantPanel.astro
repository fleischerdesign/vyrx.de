  .ui-grid[data-columns='1'] {
    grid-template-columns: minmax(0, 1fr);
  }

  .ui-grid[data-columns='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ui-grid[data-gap='xs'] {
    gap: var(--space-1);
  }

  .ui-grid[data-gap='sm'] {
    gap: var(--space-2);
  }

  .ui-grid[data-gap='md'] {
    gap: var(--space-3);
  }

  .ui-grid[data-gap='lg'] {
    gap: var(--space-5);
  }

  .ui-card {
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .ui-card[data-tone='subtle'] {
    background: var(--surface-2);
    box-shadow: none;
  }

  .ui-card[data-tone='accent'] {
    border-color: var(--accent-soft-line);
    background: var(--accent-weaker);
    box-shadow: none;
  }

  .ui-card .ui-card {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .ui-card__head {
    margin-bottom: var(--space-3);
  }

  .ui-card__title,
  .ui-section__title {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
  }

  .ui-card__description,
  .ui-section__description {
    margin-top: 2px;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .ui-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .ui-section > .ui-heading {
    margin-bottom: 2px;
  }

  .ui-text {
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .ui-text[data-variant='small'] {
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .ui-text[data-variant='muted'] {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .ui-text[data-variant='lead'] {
    color: var(--ink);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  .ui-heading {
    color: var(--ink);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  h2.ui-heading {
    font-size: var(--text-md);
  }

  h3.ui-heading {
    font-size: var(--text-sm);
  }

  h4.ui-heading {
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .ui-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: 1.1rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .ui-list:not(ol) {
    list-style: disc;
  }

  ol.ui-list {
    list-style: decimal;
  }

  .ui-list li::marker {
    color: var(--accent);
  }

  .ui-kv {
    display: grid;
    grid-template-columns: minmax(92px, max-content) minmax(0, 1fr);
    gap: 0 var(--space-4);
    margin: 0;
    font-size: var(--text-xs);
  }

  .ui-kv dt,
  .ui-kv dd {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .ui-kv dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ui-kv dd {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .ui-kv dt:last-of-type,
  .ui-kv dd:last-of-type {
    border-bottom: 0;
  }

  .ui-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .ui-badge[data-tone='accent'] {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .ui-badge[data-tone='ok'] {
    border-color: var(--ok-line);
    background: var(--ok-soft);
    color: var(--ok);
  }

  .ui-badge[data-tone='warn'] {
    border-color: var(--warn-line);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .ui-badge[data-tone='bad'] {
    border-color: var(--bad-line);
    background: var(--bad-soft);
    color: var(--bad);
  }

  .ui-callout {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--line-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface-2);
  }

  .ui-callout[data-tone='accent'] {
    border-left-color: var(--accent);
    background: var(--accent-weaker);
  }

  .ui-callout[data-tone='ok'] {
    border-left-color: var(--ok);
    background: var(--ok-soft);
  }

  .ui-callout[data-tone='warn'] {
    border-left-color: var(--warn);
    background: var(--warn-soft);
  }

  .ui-callout[data-tone='bad'] {
    border-left-color: var(--bad);
    background: var(--bad-soft);
  }

  .ui-callout__title {
    display: block;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .ui-callout p {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .ui-divider {
    width: 100%;
    margin: var(--space-1) 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .ui-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }

  .ui-stat__label {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ui-stat__value {
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .ui-stat__hint {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .ui-stat[data-tone='ok'] .ui-stat__value {
    color: var(--ok);
  }

  .ui-stat[data-tone='warn'] .ui-stat__value {
    color: var(--warn);
  }

  .ui-stat[data-tone='bad'] .ui-stat__value {
    color: var(--bad);
  }

  .ui-stat[data-tone='unknown'] .ui-stat__value {
    color: var(--unknown);
  }

  .ui-progress {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }

  .ui-progress__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ui-progress__label {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .ui-progress__value {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    white-space: nowrap;
  }

  .ui-progress__track {
    height: 6px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .ui-progress__bar {
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  .ui-progress[data-tone='ok'] .ui-progress__bar {
    background: var(--ok);
  }

  .ui-progress[data-tone='warn'] .ui-progress__bar {
    background: var(--warn);
  }

  .ui-progress[data-tone='bad'] .ui-progress__bar {
    background: var(--bad);
  }

  .ui-progress__hint {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .ui-chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--accent);
  }

  .ui-chart[data-tone='ok'] {
    color: var(--ok);
  }

  .ui-chart[data-tone='warn'] {
    color: var(--warn);
  }

  .ui-chart[data-tone='bad'] {
    color: var(--bad);
  }

  .ui-chart__label {
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .ui-chart svg {
    display: block;
    width: 100%;
    height: 44px;
    overflow: visible;
  }

  .ui-chart__bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22px, 1fr));
    align-items: end;
    gap: 5px;
    height: 72px;
  }

  .ui-chart__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    height: 100%;
    min-width: 0;
  }

  .ui-chart__track {
    display: flex;
    align-items: flex-end;
    width: 100%;
    flex: 1;
    overflow: hidden;
    border-radius: 3px;
    background: var(--surface-3);
  }

  .ui-chart__bar {
    width: 100%;
    min-height: 2px;
    border-radius: 3px 3px 0 0;
    background: currentColor;
  }

  .ui-chart__bar-label {
    max-width: 100%;
    overflow: hidden;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-chart__hint {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .ui-timeline {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ui-timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }

  .ui-timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 11px;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .ui-timeline__mark {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--unknown);
    flex: none;
    z-index: 1;
  }

  .ui-timeline li[data-tone='ok'] .ui-timeline__mark {
    background: var(--ok);
  }

  .ui-timeline li[data-tone='warn'] .ui-timeline__mark {
    background: var(--warn);
  }

  .ui-timeline li[data-tone='bad'] .ui-timeline__mark {
    background: var(--bad);
  }

  .ui-timeline__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .ui-timeline__time {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.03em;
  }

  .ui-timeline__title {
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
  }

  .ui-timeline__body p {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .ui-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .ui-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
  }

  .ui-table th,
  .ui-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .ui-table th {
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ui-table td {
    color: var(--ink-2);
  }

  .ui-table td:first-child {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  .ui-table tr:last-child td {
    border-bottom: 0;
  }

  .ui-details {
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .ui-details summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-2);
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    list-style: none;
  }

  .ui-details summary::-webkit-details-marker {
    display: none;
  }

  .ui-details summary::before {
    content: '';
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--fast) var(--ease);
  }

  .ui-details[open] summary::before {
    transform: rotate(45deg);
  }

  .ui-details > *:not(summary) {
    margin-top: var(--space-2);
  }

  .ui-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    padding: 2px 0;
    color: var(--accent-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .ui-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ui-confirm {
    padding: var(--space-4);
    border: 1px solid var(--accent-soft-line);
    border-radius: var(--radius-lg);
    background: var(--accent-weaker);
  }

  .ui-confirm__title {
    display: block;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .ui-confirm__description {
    margin-top: 2px;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .ui-confirm__media {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .ui-confirm__poster {
    position: relative;
    flex: none;
    width: 56px;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, var(--surface-2), var(--surface-3));
  }

  .ui-confirm__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-confirm__media-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ui-confirm__media-title {
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-confirm__media-meta {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-confirm__facts {
    margin-top: var(--space-3);
  }

  .ui-confirm__actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .ui-confirm__confirm {
    min-height: 2.375rem;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .ui-confirm__confirm:hover {
    background: var(--accent-strong);
  }

  .ui-confirm__confirm:disabled,
  .ui-confirm__cancel:disabled {
    opacity: 0.55;
  }

  .ui-confirm__cancel {
    min-height: 2.375rem;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .ui-confirm__cancel:hover {
    border-color: var(--accent-soft-line);
    color: var(--accent-strong);
  }

  .ui-confirm__result {
    margin-top: var(--space-3);
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .ui-confirm__result[data-tone='ok'] {
    border-color: var(--ok-line);
    background: var(--ok-soft);
    color: var(--ok);
  }

  .ui-confirm__result[data-tone='warn'] {
    border-color: var(--warn-line);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .ui-confirm__result[data-tone='bad'] {
    border-color: var(--bad-line);
    background: var(--bad-soft);
    color: var(--bad);
  }

  .ui-media-batch {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ui-media-batch__toolbar {
    display: flex;
    justify-content: flex-end;
  }

  .ui-media-batch__toggle {
    padding: 2px 0;
    border: 0;
    background: none;
    color: var(--accent-strong);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
  }

  .ui-media-batch__toggle:hover {
    color: var(--accent);
  }

  .ui-media-batch__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 8px;
    border: 1px solid var(--accent-soft-line);
    border-radius: var(--radius-md);
    background: var(--accent-weaker);
  }

  .ui-media-batch__bar[hidden] {
    display: none;
  }

  .ui-media-batch__count {
    color: var(--ink-2);
    font-size: 0.625rem;
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .ui-media-batch__hint {
    overflow: hidden;
    color: var(--bad);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-media-batch__request {
    min-height: 1.875rem;
    margin-left: auto;
    padding: 4px 10px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.625rem;
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .ui-media-batch__request:disabled {
    opacity: 0.5;
  }

  .ui-media--selected {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .ui-batch-dialog__panel {
    max-height: min(88vh, 720px);
  }

  .ui-batch-dialog__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    padding-top: var(--space-6);
  }

  .ui-batch-dialog__title {
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .ui-batch-dialog__hint {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .ui-batch-dialog__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 42vh;
    overflow: auto;
  }

  .ui-batch-dialog__row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: center;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }

  .ui-batch-dialog__poster {
    position: relative;
    width: 36px;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, var(--surface-2), var(--surface-3));
  }

  .ui-batch-dialog__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-batch-dialog__poster .ui-media__fallback svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ui-batch-dialog__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .ui-batch-dialog__info strong {
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-batch-dialog__info span {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-batch-dialog__result {
    max-width: 130px;
    color: var(--muted);
    font-size: 0.5625rem;
    line-height: 1.3;
    text-align: right;
  }

  .ui-batch-dialog__result[data-tone='ok'] {
    color: var(--ok);
  }

  .ui-batch-dialog__result[data-tone='warn'] {
    color: var(--warn);
  }

  .ui-batch-dialog__result[data-tone='bad'] {
    color: var(--bad);
  }

  .ui-batch-dialog__actions {
    display: flex;
    gap: var(--space-2);
  }

  .ui-batch-dialog__actions button {
    flex: 1;
  }

  .ui-media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .ui-media {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      border-color var(--fast) var(--ease),
      transform var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }

  .ui-media:hover {
    border-color: var(--accent-soft-line);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .ui-media:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .ui-media__poster {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: linear-gradient(145deg, var(--surface-2), var(--surface-3));
  }

  .ui-media__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-media__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--faint);
  }

  .ui-media__fallback svg {
    width: 2rem;
    height: 2rem;
    opacity: 0.7;
  }

  .ui-media__hint {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 3px 8px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-pill);
    background: rgb(15 18 26 / 0.66);
    color: #fff;
    font-size: 0.625rem;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--fast) var(--ease),
      transform var(--fast) var(--ease);
    backdrop-filter: blur(6px);
  }

  .ui-media:hover .ui-media__hint,
  .ui-media:focus-visible .ui-media__hint {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .ui-media__hint {
      opacity: 0.9;
      transform: none;
    }
  }

  .ui-media__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 8px 10px 10px;
  }

  .ui-media__title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ui-media__meta {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.5625rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ui-media__status {
    align-self: flex-start;
    margin-top: 1px;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .ui-media__status[data-status='available'] {
    border-color: var(--ok-line);
    background: var(--ok-soft);
    color: var(--ok);
  }

  .ui-media__status[data-status='requested'],
  .ui-media__status[data-status='processing'],
  .ui-media__status[data-status='partial'] {
    border-color: var(--warn-line);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .ui-media__status[data-status='blocklisted'] {
    border-color: var(--bad-line);
    background: var(--bad-soft);
    color: var(--bad);
  }

  .ui-media-dialog {
    width: min(560px, calc(100vw - 32px));
    max-width: 560px;
    max-height: min(88vh, 720px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .ui-media-dialog::backdrop {
    background: rgb(10 12 18 / 0.6);
    backdrop-filter: blur(8px);
  }

  .ui-media-dialog__panel {
    position: relative;
    overflow: auto;
    max-height: min(88vh, 720px);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .ui-media-dialog__hero {
    position: relative;
    height: 200px;
    background-color: var(--surface-3);
    background-position: center;
    background-size: cover;
  }

  .ui-media-dialog__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.12), var(--surface));
    pointer-events: none;
  }

  .ui-media-dialog__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 50%;
    background: rgb(15 18 26 / 0.5);
    color: #fff;
    font-size: 1.125rem;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .ui-media-dialog__close:hover {
    background: rgb(15 18 26 / 0.72);
  }

  .ui-media-dialog__content {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0 var(--space-5) var(--space-5);
  }

  .ui-media-dialog__poster {
    position: relative;
    width: 96px;
    aspect-ratio: 2 / 3;
    margin-top: -48px;
    overflow: hidden;
    border: 2px solid var(--surface);
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--surface-2), var(--surface-3));
    box-shadow: var(--shadow-sm);
  }

  .ui-media-dialog__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-media-dialog__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    padding-top: var(--space-3);
  }

  .ui-media-dialog__meta {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ui-media-dialog__title {
    margin-top: 2px;
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
  }

  .ui-media-dialog__quality {
    align-self: flex-start;
    margin-top: 2px;
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
  }

  .ui-media-dialog__quality:hover {
    border-color: var(--accent-soft-line);
    color: var(--accent-strong);
  }

  .ui-media-dialog__quality.is-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .ui-media-dialog__overview {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.65;
  }

  .ui-media-dialog__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .ui-media-dialog__loading {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .ui-media-dialog__tagline {
    color: var(--muted);
    font-size: var(--text-xs);
    font-style: italic;
    line-height: 1.5;
  }

  .ui-media-dialog__genres {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .ui-media-dialog__genre {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.5625rem;
    white-space: nowrap;
  }

  .ui-media-dialog__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: 50%;
    background: rgb(10 12 18 / 0.58);
    color: #fff;
    font-size: 1.375rem;
    text-decoration: none;
    transform: translate(-50%, -50%);
    transition:
      background var(--fast) var(--ease),
      transform var(--fast) var(--ease);
    backdrop-filter: blur(8px);
  }

  .ui-media-dialog__play:hover {
    background: var(--accent);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .ui-media-dialog__play[hidden] {
    display: none;
  }

  .ui-media-dialog__credits {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .ui-media-dialog__credits p {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: var(--space-2);
    color: var(--ink-2);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .ui-media-dialog__credits p span:first-child {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ui-media-dialog__seasons {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .ui-media-dialog__seasons-title {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ui-media-dialog__season-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
  }

  .ui-media-dialog__season {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: 3px 2px;
    color: var(--ink-2);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .ui-media-dialog__season input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--accent);
  }

  .ui-media-dialog__season small {
    color: var(--muted);
    font-size: 0.5625rem;
    white-space: nowrap;
  }

  .ui-media-dialog__seasons .ui-media-dialog__request {
    width: 100%;
    margin-top: var(--space-2);
  }

  .ui-media-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-4);
  }

  .ui-media-dialog__request {
    min-height: 2.375rem;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .ui-media-dialog__request:hover {
    background: var(--accent-strong);
  }

  .ui-media-dialog__feedback {
    margin-top: var(--space-3);
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .ui-media-dialog__feedback[data-tone='ok'] {
    border-color: var(--ok-line);
    background: var(--ok-soft);
    color: var(--ok);
  }

  .ui-media-dialog__feedback[data-tone='warn'] {
    border-color: var(--warn-line);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .ui-media-dialog__feedback[data-tone='bad'] {
    border-color: var(--bad-line);
    background: var(--bad-soft);
    color: var(--bad);
  }

  .ui-media-dialog__cancel {
    min-height: 2.375rem;
    padding: 8px 12px;
    border: 1px solid var(--bad-line);
    border-radius: var(--radius-md);
    background: var(--bad-soft);
    color: var(--bad);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .ui-media-dialog__cancel:hover:not(:disabled) {
    border-color: var(--bad);
  }

  .ui-media-dialog__cancel:disabled {
    opacity: 0.55;
  }

  .ui-media-dialog__dismiss {
    min-height: 2.375rem;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .ui-media-dialog__dismiss:hover {
    border-color: var(--accent-soft-line);
    color: var(--accent-strong);
  }

  @media (max-width: 560px) {
    .ui-media-dialog {
      width: 100%;
      max-width: 100%;
      max-height: 92vh;
      margin: auto 0 0;
    }

    .ui-media-dialog__panel {
      max-height: 92vh;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .ui-media-dialog__hero {
      height: 165px;
    }

    .ui-media-dialog__play {
      width: 48px;
      height: 48px;
      font-size: 1.125rem;
    }

    .ui-media-dialog__content {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: var(--space-3);
      padding: 0 var(--space-4) var(--space-4);
    }

    .ui-media-dialog__poster {
      width: 80px;
      margin-top: -40px;
    }

    .ui-media-dialog__title {
      font-size: var(--text-md);
    }

    .ui-media-dialog__actions {
      width: 100%;
    }

    .ui-media-dialog__request,
    .ui-media-dialog__dismiss {
      flex: 1;
    }
  }

  .ui-media-grid:has(> .ui-media:only-child) {
    grid-template-columns: minmax(0, 160px);
  }

  @media (max-width: 340px) {
    .ui-media-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .ui-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ui-chips button {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .ui-chips button:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-weaker);
    color: var(--accent-strong);
  }

  .ui-chips button:disabled {
    opacity: 0.55;
  }

  .ui-rows {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .ui-rows__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    color: inherit;
    text-decoration: none;
  }

  .ui-rows__head:hover {
    background: var(--surface-3);
  }

  .ui-rows__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .ui-rows__body strong {
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .ui-rows__body small {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .ui-rows__arrow {
    color: var(--faint);
    flex: none;
    font-size: 0.75rem;
  }

  .ui-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px var(--space-4);
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .ui-row:last-child {
    border-bottom: 0;
  }

  .ui-row:hover {
    background: var(--surface-2);
  }

  .ui-row:focus-visible,
  .ui-rows__head:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  .ui-row__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .ui-row__body strong {
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
  }

  .ui-row__body small {
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .ui-row__kind {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .ui-row__meta {
    color: var(--faint) !important;
  }

  .ui-row[data-state='up'] .assistant-card__dot,
  .ui-rows__head[data-state='up'] .assistant-card__dot {
    background: var(--ok);
  }

  .ui-row[data-state='down'] .assistant-card__dot,
  .ui-rows__head[data-state='down'] .assistant-card__dot {
    background: var(--bad);
  }

  .ui-row[data-state='unmonitored'] .assistant-card__dot,
  .ui-rows__head[data-state='unmonitored'] .assistant-card__dot {
    background: var(--line-strong);
  }

  @media (max-width: 360px) {
    .ui-grid,
    .ui-grid[data-columns='2'],
    .ui-grid[data-columns='3'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .assistant-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
  }

  .assistant-card:hover {
    border-color: var(--accent-soft-line);
  }

  .assistant-card__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--unknown);
    flex: none;
  }

  .assistant-card[data-state='up'] .assistant-card__dot {
    background: var(--ok);
  }

  .assistant-card[data-state='down'] .assistant-card__dot {
    background: var(--bad);
  }

  .assistant-card[data-state='unmonitored'] .assistant-card__dot {
    background: var(--line-strong);
  }

  .assistant-card--step {
    display: block;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: none;
  }

  .assistant-card__question {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.45;
  }

  .assistant-card__options {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-3);
  }

  .assistant-card__options button {
    width: 100%;
    min-height: 2.375rem;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-align: left;
  }

  .assistant-card__options button:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-weaker);
    color: var(--accent-strong);
  }

  .assistant-card__options button:disabled {
    opacity: 0.55;
  }

  .assistant-card__options button[data-selected='true'] {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .assistant-card__counter {
    display: block;
    margin-top: var(--space-2);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-wide);
  }

  .assistant__navigate-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .assistant__navigate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--accent-soft-line);
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
