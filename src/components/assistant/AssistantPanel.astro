---
/*
 * Der Assistent als ruhige Schublade, kein Chat-Fenster mit Sprechblasen.
 *
 * Er sitzt neben der Suche, weil er dieselbe Frage beantwortet wie sie: „Wo
 * finde ich das?" Nur antwortet er in Sätzen und nennt seine Quellen. Ohne
 * JavaScript bleibt der Knopf aus; die Funktion ist eine Zugabe, keine Pflicht.
 */
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { pathFor, type Locale } from '@/lib/locale';

interface Props {
  readonly locale: Locale;
  readonly name: string;
  /** Für den getrennten Verlauf je Person im selben Browser-Tab. */
  readonly user: string;
  /** Der Dienst der aktuellen Seite, falls es eine Dienstseite ist. */
  readonly pageService?: { readonly id: string; readonly name: string } | null;
  readonly suggestions: readonly string[];
}

const { locale, name, user, pageService = null, suggestions } = Astro.props;
const t = useTranslations(locale);
const greeting = name ? t('assistantGreeting', { name }) : t('assistantHello');

const labels = {
  thinking: t('assistantThinking'),
  send: t('assistantSend'),
  stop: t('assistantStop'),
  retry: t('assistantRetry'),
  error: t('assistantError'),
  stopped: t('assistantStopped'),
  interrupted: t('assistantInterrupted'),
  empty: t('assistantEmpty'),
  sources: t('assistantSources'),
  tooMany: t('assistantTooMany'),
  unavailable: t('assistantUnavailable'),
  signIn: t('assistantSignIn'),
  measured: t('assistantMeasured'),
  never: t('statusNever'),
  stateUp: t('stateUp'),
  stateDown: t('stateDown'),
  stateUnknown: t('stateUnknown'),
  stateUnmonitored: t('stateUnmonitored'),
  open: t('assistantOpenLink'),
  cancel: t('cancel'),
  save: t('save'),
  history: t('assistantHistory'),
  historySearch: t('assistantHistorySearch'),
  historyEmpty: t('assistantHistoryEmpty'),
  historyError: t('assistantHistoryError'),
  threadRename: t('assistantThreadRename'),
  threadDelete: t('assistantThreadDelete'),
  threadDeleteConfirm: t('assistantThreadDeleteConfirm'),
  threadPin: t('assistantThreadPin'),
  threadUnpin: t('assistantThreadUnpin'),
  threadPinned: t('assistantThreadPinned'),
  threadToday: t('assistantThreadToday'),
  threadYesterday: t('assistantThreadYesterday'),
  threadOlder: t('assistantThreadOlder'),
  threadUntitled: t('assistantThreadUntitled'),
  threadMore: t('assistantThreadMore'),
};
---

<button
  type="button"
  class="assistant-fab"
  data-assistant-open
  data-assistant-surface
  hidden
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="assistant"
  aria-label={t('assistantOpen')}
  title={`${t('assistantOpen')} (⌘J)`}
>
  <Icon name="sparkles" size="1.25rem" />
  <span class="assistant-fab__label" aria-hidden="true">{t('assistantOpen')}</span>
</button>

<dialog class="assistant" id="assistant" aria-labelledby="assistant-title">
  <div class="assistant__panel">
    <header class="assistant__head">
      <span class="assistant__mark" aria-hidden="true"><Icon name="sparkles" size="1.05rem" /></span>
      <span class="assistant__title">
        <strong id="assistant-title">{t('assistantTitle')}</strong>
        <small>{t('assistantSubtitle')}</small>
      </span>
      <button type="button" class="assistant__icon" data-assistant-history title={t('assistantHistory')} aria-label={t('assistantHistory')} aria-expanded="false">
        <Icon name="list" size="1rem" />
      </button>
      <button type="button" class="assistant__icon" data-assistant-new title={t('assistantNew')} aria-label={t('assistantNew')}>
        <Icon name="plus" size="1rem" />
      </button>
      <button type="button" class="assistant__icon" data-assistant-close title={t('close')} aria-label={t('close')}>
        <Icon name="close" size="1rem" />
      </button>
    </header>

    <div class="assistant__context" data-assistant-context hidden>
      <span class="assistant__context-dot" aria-hidden="true"></span>
      <strong data-assistant-context-name></strong>
      <span data-assistant-context-state></span>
      <a class="assistant__context-link" href={pathFor(locale, 'status')}>{t('assistantStatusLink')}</a>
    </div>

    <section class="assistant__threads" data-assistant-threads aria-label={t('assistantHistory')} hidden>
      <div class="assistant__threads-head">
        <button type="button" class="assistant__threads-back" data-assistant-threads-back aria-label={t('back')}>
          <Icon name="arrowLeft" size="1rem" />
        </button>
        <strong>{t('assistantHistory')}</strong>
        <button type="button" class="assistant__threads-new" data-assistant-threads-new aria-label={t('assistantNew')} title={t('assistantNew')}>
          <Icon name="plus" size="1rem" />
        </button>
      </div>
      <label class="assistant__threads-search">
        <Icon name="search" size="0.95rem" />
        <span class="visually-hidden">{t('assistantHistorySearch')}</span>
        <input type="search" placeholder={t('assistantHistorySearch')} data-assistant-threads-search />
      </label>
      <div class="assistant__threads-list" data-assistant-threads-list></div>
      <p class="assistant__threads-empty" data-assistant-threads-empty>{t('assistantHistoryEmpty')}</p>
    </section>

    <div class="assistant__log" data-assistant-log role="log" aria-live="polite" aria-relevant="additions text">
      <div class="assistant__intro" data-assistant-intro>
        <p class="assistant__hello">{greeting}</p>
        <p class="assistant__sub">{t('assistantIntro')}</p>
        <div class="assistant__suggestions">
          {suggestions.map((suggestion) => (
            <button type="button" data-assistant-suggestion>{suggestion}</button>
          ))}
        </div>
      </div>
    </div>

    <form class="assistant__composer" data-assistant-form>
      <label class="visually-hidden" for="assistant-input">{t('assistantInputLabel')}</label>
      <div class="assistant__field">
        <textarea
          id="assistant-input"
          rows="1"
          maxlength="2000"
          placeholder={t('assistantPlaceholder')}
          data-assistant-input></textarea>
        <button type="submit" class="assistant__send" data-assistant-send aria-label={t('assistantSend')} title={t('assistantSend')}>
          <Icon name="arrowUp" size="1rem" />
        </button>
      </div>
      <div class="assistant__foot">
        <span>{t('assistantFoot')}</span>
        <span>{t('assistantDisclaimer')}</span>
      </div>
    </form>
  </div>
</dialog>

<script type="application/json" data-assistant-config set:html={JSON.stringify({ locale, page: Astro.url.pathname, user, service: pageService, labels, suggestions })}></script>

<script>
  import type { AssistantBlock } from '@/lib/assistant-blocks.ts';
  import { SseParser } from '@/lib/sse.ts';

  interface Config {
    readonly locale: 'de' | 'en';
    readonly page: string;
    readonly user: string;
    readonly service?: { readonly id: string; readonly name: string } | null;
    readonly labels: Record<string, string>;
    readonly suggestions?: readonly string[];
  }

  interface Source {
    readonly ref: string;
    readonly kind: string;
    readonly label: string;
    readonly href: string;
  }

  interface Navigation {
    readonly href: string;
    readonly label: string;
  }

  type Message = {
    role: 'user' | 'assistant';
    content: string;
    sources?: readonly Source[];
    ui?: readonly AssistantBlock[];
    blocks?: readonly AssistantBlock[];
    navigations?: readonly Navigation[];
  };

  interface ThreadSummary {
    readonly id: string;
    readonly title: string;
    readonly preview: string;
    readonly pinned: boolean;
    readonly createdAt: string;
    readonly updatedAt: string;
  }

  interface ThreadDetail extends ThreadSummary {
    readonly messages: readonly Message[];
    readonly summary: string | null;
    readonly summaryUntilId: number | null;
  }

  const dialog = document.getElementById('assistant') as HTMLDialogElement | null;
  const fab = document.querySelector<HTMLButtonElement>('.assistant-fab');
  const form = document.querySelector<HTMLFormElement>('[data-assistant-form]');
  const input = document.querySelector<HTMLTextAreaElement>('[data-assistant-input]');
  const sendButton = document.querySelector<HTMLButtonElement>('[data-assistant-send]');
  const log = document.querySelector<HTMLElement>('[data-assistant-log]');
  const intro = document.querySelector<HTMLElement>('[data-assistant-intro]');
  const contextStrip = document.querySelector<HTMLElement>('[data-assistant-context]');
  const contextName = document.querySelector<HTMLElement>('[data-assistant-context-name]');
  const contextState = document.querySelector<HTMLElement>('[data-assistant-context-state]');
  const historyButton = document.querySelector<HTMLButtonElement>('[data-assistant-history]');
  const threadsPanel = document.querySelector<HTMLElement>('[data-assistant-threads]');
  const threadsList = document.querySelector<HTMLElement>('[data-assistant-threads-list]');
  const threadsEmpty = document.querySelector<HTMLElement>('[data-assistant-threads-empty]');
  const threadsSearch = document.querySelector<HTMLInputElement>('[data-assistant-threads-search]');
  const threadsBack = document.querySelector<HTMLButtonElement>('[data-assistant-threads-back]');
  const threadsNew = document.querySelector<HTMLButtonElement>('[data-assistant-threads-new]');
  const dialogPanel = dialog?.querySelector<HTMLElement>('.assistant__panel') ?? null;
  const configNode = document.querySelector<HTMLScriptElement>('[data-assistant-config]');

  if (dialog && fab && form && input && sendButton && log && intro && configNode) {
    let config: Config;
    try {
      config = JSON.parse(configNode.textContent ?? '{}') as Config;
    } catch {
      config = { locale: 'de', page: location.pathname, user: '', labels: {} };
    }

    const labels = config.labels ?? {};
    const page = typeof config.page === 'string' ? config.page : location.pathname;
    const locale = config.locale === 'en' ? 'en' : 'de';
    const storageKey = `vyrx.assistant.history.${config.user || 'guest'}`;
    const pageService = config.service ?? null;
    let statusLoaded = false;

    let messages: Message[] = [];
    let busy = false;
    let controller: AbortController | null = null;
    let run = 0;
    let streamFrame = 0;
    let currentThreadId: string | null = null;
    let threads: ThreadSummary[] = [];
    let historySearchTimer: number | null = null;
    let threadsReady: Promise<void> = Promise.resolve();
    let freshRequested = false;
    const threadStorageKey = `vyrx.assistant.thread.${config.user || 'guest'}`;

    const scroll = (): void => {
      log.scrollTop = log.scrollHeight;
    };

    const formatTime = (at: number): string =>
      new Date(at).toLocaleString(locale, { dateStyle: 'short', timeStyle: 'short' });

    const stateText = (state: string): string =>
      state === 'up'
        ? (labels.stateUp ?? '')
        : state === 'down'
          ? (labels.stateDown ?? '')
          : state === 'unmonitored'
            ? (labels.stateUnmonitored ?? '')
            : (labels.stateUnknown ?? '');

    const loadPageStatus = async (): Promise<void> => {
      if (!pageService || !contextStrip || !contextName || !contextState) return;
      contextName.textContent = pageService.name;
      contextStrip.hidden = false;

      try {
        const response = await fetch('/api/status', { headers: { accept: 'application/json' } });
        if (!response.ok) return;
        const data = (await response.json()) as {
          services?: Record<string, { state?: string; asOf?: number | null }>;
        };
        const live = data.services?.[pageService.id];
        if (!live) return;

        const state =
          live.state === 'up' || live.state === 'down' || live.state === 'unmonitored'
            ? live.state
            : 'unknown';
        const measured = live.asOf
          ? (labels.measured ?? '').replace('{time}', formatTime(live.asOf))
          : (labels.never ?? '');
        contextStrip.dataset.state = state;
        contextState.textContent =
          state === 'unmonitored' ? stateText(state) : measured ? `${stateText(state)} · ${measured}` : stateText(state);
      } catch {
        // Der Name bleibt sichtbar; der Zustand fehlt dann eben.
      }
    };

    const setBusy = (value: boolean): void => {
      busy = value;
      sendButton.dataset.mode = value ? 'stop' : 'send';
      sendButton.setAttribute('aria-label', value ? (labels.stop ?? '') : (labels.send ?? ''));
      sendButton.title = value ? (labels.stop ?? '') : (labels.send ?? '');
      log.setAttribute('aria-busy', String(value));
    };

    const renderInline = (parent: HTMLElement, value: string): void => {
      const pattern = /(\*\*[^*]+\*\*|`[^`]+`|\[[^\]]+\]\([^)]+\))/g;
      let last = 0;
      let match: RegExpExecArray | null;

      while ((match = pattern.exec(value)) !== null) {
        if (match.index > last) parent.append(document.createTextNode(value.slice(last, match.index)));
        const token = match[0];

        if (token.startsWith('**')) {
          const strong = document.createElement('strong');
          strong.textContent = token.slice(2, -2);
          parent.append(strong);
        } else if (token.startsWith('`')) {
          const code = document.createElement('code');
          code.textContent = token.slice(1, -1);
          parent.append(code);
        } else {
          const link = /^\[([^\]]+)\]\(([^)]+)\)$/.exec(token);
          const href = link?.[2] ?? '';
          if (link && href.startsWith('/') && !href.startsWith('//')) {
            const anchor = document.createElement('a');
            anchor.href = href;
            anchor.textContent = link?.[1] ?? href;
            parent.append(anchor);
          } else {
            parent.append(document.createTextNode(token));
          }
        }
        last = pattern.lastIndex;
      }

      if (last < value.length) parent.append(document.createTextNode(value.slice(last)));
    };

    const trimIncomplete = (value: string): string => {
      let out = value;
      const bold = (out.match(/\*\*/g) ?? []).length;
      if (bold % 2 === 1) out = out.replace(/\*\*(?=[^*]*$)/, '');
      const ticks = (out.match(/`/g) ?? []).length;
      if (ticks % 2 === 1) out = out.replace(/`(?=[^`]*$)/, '');
      if (/(^|[^*])\*$/.test(out) && !/\*\*$/.test(out)) out = out.slice(0, -1);
      return out;
    };

    const appendCursor = (answer: HTMLElement): void => {
      const cursor = document.createElement('span');
      cursor.className = 'assistant__cursor';
      cursor.setAttribute('aria-hidden', 'true');
      const last = answer.lastElementChild;
      const target = last?.tagName === 'UL' ? last.lastElementChild : last;
      (target ?? answer).append(cursor);
    };

    const renderMarkdown = (answer: HTMLElement, value: string, streaming: boolean): void => {
      const source = (streaming ? trimIncomplete(value) : value)
        .replace(/^:::+s*w*s*$/gm, '')
        .replace(/\n{3,}/g, '\n\n');
      answer.replaceChildren();
      answer.classList.toggle('is-ready', !streaming);
      answer.classList.toggle('is-streaming', streaming);

      const blocks = source.split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);
      if (blocks.length === 0 && !streaming && !value.trim()) {
        const paragraph = document.createElement('p');
        paragraph.textContent = labels.empty ?? '';
        answer.append(paragraph);
      }

      for (const block of blocks) {
        const lines = block.split('\n').map((line) => line.trim()).filter(Boolean);
        const bullets = lines.filter((line) => /^[•-]\s+/.test(line));
        if (bullets.length === lines.length && lines.length > 0) {
          const list = document.createElement('ul');
          for (const line of lines) {
            const item = document.createElement('li');
            renderInline(item, line.replace(/^[•-]\s+/, ''));
            list.append(item);
          }
          answer.append(list);
        } else {
          const paragraph = document.createElement('p');
          lines.forEach((line, index) => {
            if (index > 0) paragraph.append(document.createElement('br'));
            renderInline(paragraph, line);
          });
          answer.append(paragraph);
        }
      }

      if (streaming) appendCursor(answer);
    };

    const scheduleStreamRender = (answer: HTMLElement, value: string): void => {
      if (streamFrame) return;
      streamFrame = requestAnimationFrame(() => {
        streamFrame = 0;
        if (!answer.isConnected) return;
        renderMarkdown(answer, value, true);
        scroll();
      });
    };

    const renderSources = (turn: HTMLElement, text: string, sources: readonly Source[]): void => {
      if (!Array.isArray(sources) || sources.length === 0) return;
      const cited = new Set((text.match(/\[(S\d+|A\d+|W\d+|N\d+)\]/g) ?? []).map((token) => token.slice(1, -1)));
      const mentioned = sources.filter((source) => text.includes(source.label));
      const priority: Record<string, number> = { status: 0, service: 1, article: 2, announcement: 3 };
      const chosen = (cited.size > 0 ? sources.filter((source) => cited.has(source.ref)) : mentioned.length > 0 ? mentioned : sources)
        .slice()
        .sort((a, b) => (priority[a.kind] ?? 9) - (priority[b.kind] ?? 9))
        .slice(0, 5);
      if (chosen.length === 0) return;

      const wrap = document.createElement('div');
      wrap.className = 'assistant__sources';
      const label = document.createElement('span');
      label.className = 'assistant__sources-label';
      label.textContent = labels.sources ?? '';
      wrap.append(label);

      for (const source of chosen) {
        if (!source || typeof source.label !== 'string' || typeof source.href !== 'string') continue;
        if (!source.href.startsWith('/') || source.href.startsWith('//')) continue;
        const anchor = document.createElement('a');
        anchor.className = 'assistant__source';
        anchor.href = source.href;
        anchor.textContent = source.label;
        wrap.append(anchor);
      }

      if (wrap.childElementCount > 1) turn.append(wrap);
    };

    const safeHref = (href: unknown): string | null =>
      typeof href === 'string' && href.startsWith('/') && !href.startsWith('//') && !href.includes('\\') ? href : null;

    const blockKey = (block: AssistantBlock): string | null => {
      switch (block.type) {
        case 'summary':
          return 'summary';
        case 'status':
        case 'service':
          return `service:${block.serviceId}`;
        case 'article':
          return `article:${block.slug}`;
        case 'media':
          return `media:${block.mediaType}:${block.tmdbId}`;
        case 'confirm':
          return `confirm:${block.proposalId}`;
        case 'maintenance':
          return `maintenance:${block.startsAt}:${block.endsAt}:${block.serviceId ?? 'all'}`;
        case 'step':
          return `step:${block.question}`;
        case 'suggestions':
          return 'suggestions';
        default:
          // Generische Layout- und Inhalt-Knoten werden nicht dedupliziert.
          return null;
      }
    };

    const renderUi = (turn: HTMLElement, nodes: readonly AssistantBlock[]): void => {
      if (!Array.isArray(nodes) || nodes.length === 0) return;
      const pruneMediaForConfirm = (): void => {
        if (!turn.querySelector('.ui-confirm')) return;
        for (const media of turn.querySelectorAll('.ui-media')) media.remove();
        for (const grid of turn.querySelectorAll('.ui-media-grid')) grid.remove();
        for (const chips of turn.querySelectorAll('.ui-chips')) chips.remove();
      };
      pruneMediaForConfirm();
      const wrap = document.createElement('div');
      wrap.className = 'assistant__ui';
      const seen = new Set<string>();

      const renderInlineWithBreaks = (parent: HTMLElement, value: string): void => {
        value.split('\n').forEach((line, index) => {
          if (index > 0) parent.append(document.createElement('br'));
          renderInline(parent, line);
        });
      };

      const isRowType = (node: AssistantBlock): boolean =>
        node.type === 'summary' ||
        node.type === 'status' ||
        node.type === 'service' ||
        node.type === 'article' ||
        node.type === 'maintenance';

      const renderRows = (parent: HTMLElement, rows: readonly AssistantBlock[]): void => {
        if (!Array.isArray(rows) || rows.length === 0) return;
        const container = document.createElement('div');
        container.className = 'ui-rows';
        let start = 0;

        if (rows[0]?.type === 'summary') {
          const summary = rows[0];
          const href = safeHref(summary.href);
          const head = document.createElement(href ? 'a' : 'div');
          head.className = 'ui-rows__head';
          head.dataset.state = summary.tone === 'ok' ? 'up' : summary.tone === 'warn' ? 'down' : 'unknown';
          if (href) (head as HTMLAnchorElement).href = href;
          const dot = document.createElement('span');
          dot.className = 'assistant-card__dot';
          dot.setAttribute('aria-hidden', 'true');
          const body = document.createElement('span');
          body.className = 'ui-rows__body';
          const title = document.createElement('strong');
          title.textContent = summary.title;
          const text = document.createElement('small');
          text.textContent = [summary.text, summary.asOf ? formatTime(summary.asOf) : ''].filter(Boolean).join(' · ');
          body.append(title, text);
          head.append(dot, body);
          if (href) {
            const arrow = document.createElement('span');
            arrow.className = 'ui-rows__arrow';
            arrow.textContent = '→';
            head.append(arrow);
          }
          container.append(head);
          start = 1;
        }

        for (let index = start; index < rows.length; index += 1) {
          const row = rows[index];
          if (!row) continue;

          if (row.type === 'status') {
            const href = safeHref(row.href);
            if (!href) continue;
            const link = document.createElement('a');
            link.className = 'ui-row ui-row--status';
            link.href = href;
            link.dataset.state = row.state;
            const dot = document.createElement('span');
            dot.className = 'assistant-card__dot';
            dot.setAttribute('aria-hidden', 'true');
            const body = document.createElement('span');
            body.className = 'ui-row__body';
            const name = document.createElement('strong');
            name.textContent = row.name;
            const meta = document.createElement('small');
            meta.textContent = [row.stateText, row.asOf ? formatTime(row.asOf) : ''].filter(Boolean).join(' · ');
            body.append(name, meta);
            const arrow = document.createElement('span');
            arrow.className = 'ui-rows__arrow';
            arrow.textContent = '→';
            link.append(dot, body, arrow);
            container.append(link);
            continue;
          }

          if (row.type === 'service') {
            const href = safeHref(row.href);
            if (!href) continue;
            const link = document.createElement('a');
            link.className = 'ui-row ui-row--service';
            link.href = href;
            const body = document.createElement('span');
            body.className = 'ui-row__body';
            const name = document.createElement('strong');
            name.textContent = row.name;
            const summary = document.createElement('small');
            summary.textContent = row.summary;
            const meta = document.createElement('small');
            meta.className = 'ui-row__meta';
            meta.textContent = [row.stateText, row.asOf ? formatTime(row.asOf) : ''].filter(Boolean).join(' · ');
            body.append(name, summary, meta);
            const arrow = document.createElement('span');
            arrow.className = 'ui-rows__arrow';
            arrow.textContent = '→';
            link.append(body, arrow);
            container.append(link);
            continue;
          }

          if (row.type === 'article') {
            const href = safeHref(row.href);
            if (!href) continue;
            const link = document.createElement('a');
            link.className = 'ui-row ui-row--article';
            link.href = href;
            const body = document.createElement('span');
            body.className = 'ui-row__body';
            const kind = document.createElement('span');
            kind.className = 'ui-row__kind';
            kind.textContent = row.kindText || row.kind || '';
            const title = document.createElement('strong');
            title.textContent = row.title;
            const summary = document.createElement('small');
            summary.textContent = row.summary;
            body.append(kind, title, summary);
            const arrow = document.createElement('span');
            arrow.className = 'ui-rows__arrow';
            arrow.textContent = '→';
            link.append(body, arrow);
            container.append(link);
            continue;
          }

          if (row.type === 'maintenance') {
            const item = document.createElement('div');
            item.className = 'ui-row ui-row--maintenance';
            const body = document.createElement('span');
            body.className = 'ui-row__body';
            const name = document.createElement('strong');
            name.textContent = row.serviceName ?? (locale === 'de' ? 'Alle Angebote' : 'All applications');
            const time = document.createElement('small');
            time.textContent = `${formatTime(Date.parse(row.startsAt))} – ${formatTime(Date.parse(row.endsAt))}`;
            body.append(name, time);
            if (row.note) {
              const note = document.createElement('small');
              note.textContent = row.note;
              body.append(note);
            }
            item.append(body);
            container.append(item);
          }
        }

        if (container.childElementCount > 0) parent.append(container);
      };

      const isMediaType = (node: AssistantBlock): boolean => node.type === 'media';

      let mediaDialogSeq = 0;

      const mediaFallback = (): HTMLSpanElement => {
        const fallback = document.createElement('span');
        fallback.className = 'ui-media__fallback';
        fallback.setAttribute('aria-hidden', 'true');
        fallback.innerHTML =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg>';
        return fallback;
      };

      const openMediaDialog = (block: AssistantBlock, trigger: HTMLElement): void => {
        if (block.type !== 'media') return;
        const dialog = document.createElement('dialog');
        dialog.className = 'ui-media-dialog';
        const titleId = `media-dialog-title-${++mediaDialogSeq}`;
        dialog.setAttribute('aria-labelledby', titleId);

        const panel = document.createElement('div');
        panel.className = 'ui-media-dialog__panel';

        const hero = document.createElement('div');
        hero.className = 'ui-media-dialog__hero';
        hero.setAttribute('aria-hidden', 'true');
        if (block.backdropPath) {
          hero.style.backgroundImage = `url("/api/media/poster?path=${encodeURIComponent(block.backdropPath)}&size=w780")`;
        }

        const play = document.createElement('a');
        play.className = 'ui-media-dialog__play';
        play.hidden = true;
        play.target = '_blank';
        play.rel = 'noopener noreferrer';
        play.textContent = '▶';
        play.setAttribute('aria-label', locale === 'de' ? 'Trailer abspielen' : 'Play trailer');
        play.title = locale === 'de' ? 'Trailer' : 'Trailer';
        hero.append(play);

        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'ui-media-dialog__close';
        close.setAttribute('aria-label', locale === 'de' ? 'Schließen' : 'Close');
        close.textContent = '×';

        const content = document.createElement('div');
        content.className = 'ui-media-dialog__content';

        const poster = document.createElement('div');
        poster.className = 'ui-media-dialog__poster';
        const fallback = mediaFallback();
        poster.append(fallback);
        if (block.posterPath) {
          const image = document.createElement('img');
          image.alt = '';
          image.decoding = 'async';
          image.src = `/api/media/poster?path=${encodeURIComponent(block.posterPath)}`;
          image.addEventListener('load', () => fallback.remove());
          image.addEventListener('error', () => image.remove());
          poster.append(image);
        }

        const body = document.createElement('div');
        body.className = 'ui-media-dialog__body';
        let is4k = false;
        const runtimeText = (minutes: number | null | undefined): string => {
          if (!minutes || minutes <= 0) return '';
          const hours = Math.floor(minutes / 60);
          const rest = minutes % 60;
          if (locale === 'de') return hours > 0 ? `${hours} Std. ${rest} Min.` : `${rest} Min.`;
          return hours > 0 ? `${hours}h ${rest}m` : `${rest}m`;
        };
        const metaLine = (item: AssistantBlock): string => {
          if (item.type !== 'media') return '';
          return [
            item.year,
            item.mediaType === 'movie' ? (locale === 'de' ? 'Film' : 'Film') : locale === 'de' ? 'Serie' : 'Series',
            runtimeText(item.runtime),
            item.rating !== null ? `★ ${item.rating.toFixed(1)}` : '',
          ]
            .filter(Boolean)
            .join(' · ');
        };
        const meta = document.createElement('span');
        meta.className = 'ui-media-dialog__meta';
        meta.textContent = metaLine(block);
        const title = document.createElement('h2');
        title.id = titleId;
        title.className = 'ui-media-dialog__title';
        title.textContent = block.title;
        const status = document.createElement('span');
        status.className = 'ui-media__status';
        status.dataset.status = block.status;
        status.textContent = block.statusText;
        let statusPollTimer: number | null = null;
        const pollStatus = (): void => {
          let attempts = 0;
          const tick = async (): Promise<void> => {
            attempts += 1;
            try {
              const response = await fetch(
                `/api/media/status?mediaType=${block.mediaType}&tmdbId=${block.tmdbId}&title=${encodeURIComponent(block.title)}&locale=${locale}`,
              );
              const data = (await response.json()) as { status?: string; statusText?: string };
              if (data.status && data.status !== 'unknown') {
                status.dataset.status = data.status;
                status.textContent = data.statusText ?? data.status;
              }
            } catch {
              // Status bleibt der letzte bekannte Stand.
            }
            if (attempts < 3 && statusPollTimer !== null) {
              statusPollTimer = window.setTimeout(() => { void tick(); }, 15_000);
            }
          };
          statusPollTimer = window.setTimeout(() => { void tick(); }, 5_000);
        };

        const quality = document.createElement('button');
        quality.type = 'button';
        quality.className = 'ui-media-dialog__quality';
        quality.textContent = '4K';
        quality.setAttribute('aria-pressed', 'false');
        quality.hidden = block.can4k !== true;
        quality.addEventListener('click', () => {
          is4k = !is4k;
          quality.setAttribute('aria-pressed', String(is4k));
          quality.classList.toggle('is-active', is4k);
        });
        const overview = document.createElement('p');
        overview.className = 'ui-media-dialog__overview';
        overview.textContent = block.overview || (locale === 'de' ? 'Keine Beschreibung verfügbar.' : 'No description available.');

        const details = document.createElement('div');
        details.className = 'ui-media-dialog__details';
        const seasonSlot = document.createElement('div');
        seasonSlot.className = 'ui-media-dialog__season-slot';
        const renderSeasons = (item: AssistantBlock): void => {
          if (item.type !== 'media') return;
          if (block.mediaType !== 'tv' || block.status !== 'unknown' || !block.requestable) return;
          const regular = Array.isArray(item.seasons) ? item.seasons.filter((season) => season.seasonNumber > 0) : [];
          seasonSlot.replaceChildren();
          if (regular.length === 0) return;
          const section = document.createElement('section');
          section.className = 'ui-media-dialog__seasons';
          const heading = document.createElement('span');
          heading.className = 'ui-media-dialog__seasons-title';
          heading.textContent = locale === 'de' ? 'Staffeln' : 'Seasons';
          const list = document.createElement('div');
          list.className = 'ui-media-dialog__season-list';
          for (const season of regular) {
            const label = document.createElement('label');
            label.className = 'ui-media-dialog__season';
            const input = document.createElement('input');
            input.type = 'checkbox';
            input.value = String(season.seasonNumber);
            input.checked = true;
            const text = document.createElement('span');
            text.textContent = season.name;
            const count = document.createElement('small');
            count.textContent = season.episodeCount !== null ? (locale === 'de' ? `${season.episodeCount} Folgen` : `${season.episodeCount} episodes`) : '';
            label.append(input, text, count);
            list.append(label);
          }
          const feedback = document.createElement('p');
          feedback.className = 'ui-media-dialog__feedback';
          feedback.setAttribute('role', 'status');
          feedback.hidden = true;
          const request = document.createElement('button');
          request.type = 'button';
          request.className = 'ui-media-dialog__request';
          request.textContent = locale === 'de' ? 'Staffeln anfragen' : 'Request seasons';
          request.addEventListener('click', async () => {
            const selected = [...list.querySelectorAll('input:checked')]
              .map((input) => Number((input as HTMLInputElement).value))
              .filter((value) => Number.isInteger(value) && value > 0);
            if (selected.length === 0) {
              feedback.hidden = false;
              feedback.dataset.tone = 'bad';
              feedback.textContent = locale === 'de' ? 'Bitte mindestens eine Staffel wählen.' : 'Select at least one season.';
              return;
            }
            request.disabled = true;
            feedback.hidden = false;
            feedback.dataset.tone = 'neutral';
            feedback.textContent = locale === 'de' ? 'Wird angefragt …' : 'Requesting …';
            try {
              const response = await fetch('/api/media/request', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ mediaType: 'tv', tmdbId: block.tmdbId, seasons: selected, is4k, locale }),
              });
              const data = (await response.json()) as { outcome?: string; message?: string };
              const accepted = data.outcome === 'accepted' || data.outcome === 'already';
              feedback.dataset.tone = accepted ? (data.outcome === 'accepted' ? 'ok' : 'warn') : 'bad';
              feedback.textContent =
                data.message ??
                (locale === 'de' ? 'Die Anfrage konnte nicht abgeschlossen werden.' : 'The request could not be completed.');
              if (accepted) {
                status.dataset.status = 'requested';
                status.textContent = locale === 'de' ? 'angefragt' : 'requested';
                request.textContent = locale === 'de' ? 'Angefragt' : 'Requested';
                pollStatus();
              } else if (data.outcome === 'rate') {
                request.disabled = false;
              }
              scroll();
            } catch {
              feedback.dataset.tone = 'bad';
              feedback.textContent = locale === 'de' ? 'Die Verbindung ist fehlgeschlagen.' : 'The connection failed.';
              scroll();
            }
          });
          section.append(heading, list, request, feedback);
          seasonSlot.append(section);
        };

        const renderDetails = (item: AssistantBlock): void => {
          if (item.type !== 'media') return;
          details.replaceChildren();
          meta.textContent = metaLine(item);
          if (item.overview) overview.textContent = item.overview;
          if (item.tagline) {
            const tagline = document.createElement('p');
            tagline.className = 'ui-media-dialog__tagline';
            tagline.textContent = item.tagline;
            details.append(tagline);
          }
          const genreList = Array.isArray(item.genres) ? item.genres : [];
          const castList = Array.isArray(item.cast) ? item.cast : [];
          const seasons = item.numberOfSeasons ?? null;
          const episodes = item.numberOfEpisodes ?? null;
          const votes = item.voteCount ?? null;
          if (genreList.length > 0) {
            const genres = document.createElement('div');
            genres.className = 'ui-media-dialog__genres';
            for (const genre of genreList) {
              const chip = document.createElement('span');
              chip.className = 'ui-media-dialog__genre';
              chip.textContent = genre;
              genres.append(chip);
            }
            details.append(genres);
          }
          const trailerKey = typeof item.trailerKey === 'string' && /^[A-Za-z0-9_-]{6,20}$/.test(item.trailerKey) ? item.trailerKey : null;
          play.hidden = !trailerKey;
          if (trailerKey) play.href = `https://www.youtube.com/watch?v=${encodeURIComponent(trailerKey)}`;
          const creditBlock = document.createElement('div');
          creditBlock.className = 'ui-media-dialog__credits';
          const addCredit = (label: string, value: string): void => {
            const row = document.createElement('p');
            const term = document.createElement('span');
            term.textContent = label;
            const text = document.createElement('span');
            text.textContent = value;
            row.append(term, text);
            creditBlock.append(row);
          };
          if (item.director) addCredit(locale === 'de' ? 'Regie' : 'Director', item.director);
          if (castList.length > 0) addCredit(locale === 'de' ? 'Cast' : 'Cast', castList.map((person) => person.name).join(', '));
          if (seasons !== null) {
            addCredit(
              locale === 'de' ? 'Staffeln' : 'Seasons',
              `${seasons}${episodes !== null ? ` · ${episodes} ${locale === 'de' ? 'Folgen' : 'episodes'}` : ''}`,
            );
          }
          if (votes !== null) {
            addCredit(
              locale === 'de' ? 'Bewertungen' : 'Votes',
              new Intl.NumberFormat(locale === 'de' ? 'de-DE' : 'en-GB').format(votes),
            );
          }
          if (creditBlock.childElementCount > 0) details.append(creditBlock);
          renderSeasons(item);
        };
        const hasRichDetails =
          (block.runtime ?? null) !== null || (block.genres?.length ?? 0) > 0 || (block.cast?.length ?? 0) > 0;
        if (hasRichDetails) renderDetails(block);
        else {
          const loading = document.createElement('span');
          loading.className = 'ui-media-dialog__loading';
          loading.textContent = locale === 'de' ? 'Details werden geladen …' : 'Loading details …';
          details.append(loading);
        }

        body.append(meta, title, status, quality, overview, details, seasonSlot);

        const actions = document.createElement('div');
        actions.className = 'ui-media-dialog__actions';
        if (block.mediaType === 'movie' && block.status === 'unknown' && block.requestable) {
          const request = document.createElement('button');
          request.type = 'button';
          request.className = 'ui-media-dialog__request';
          request.textContent = locale === 'de' ? 'Anfragen' : 'Request';
          request.addEventListener('click', async () => {
            request.disabled = true;
            feedback.hidden = false;
            feedback.dataset.tone = 'neutral';
            feedback.textContent = locale === 'de' ? 'Wird angefragt …' : 'Requesting …';
            try {
              const response = await fetch('/api/media/request', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ mediaType: block.mediaType, tmdbId: block.tmdbId, is4k, locale }),
              });
              const data = (await response.json()) as { outcome?: string; message?: string };
              const accepted = data.outcome === 'accepted' || data.outcome === 'already';
              feedback.dataset.tone = accepted ? (data.outcome === 'accepted' ? 'ok' : 'warn') : 'bad';
              feedback.textContent =
                data.message ??
                (locale === 'de' ? 'Die Anfrage konnte nicht abgeschlossen werden.' : 'The request could not be completed.');
              if (accepted) {
                status.dataset.status = 'requested';
                status.textContent = locale === 'de' ? 'angefragt' : 'requested';
                request.textContent = locale === 'de' ? 'Angefragt' : 'Requested';
                pollStatus();
              } else if (data.outcome === 'rate') {
                request.disabled = false;
              }
              scroll();
            } catch {
              feedback.dataset.tone = 'bad';
              feedback.textContent = locale === 'de' ? 'Die Verbindung ist fehlgeschlagen.' : 'The connection failed.';
              scroll();
            }
          });
          actions.append(request);
        }
        const cancelRequestButton = block.status === 'requested' ? document.createElement('button') : null;
        if (cancelRequestButton) {
          cancelRequestButton.type = 'button';
          cancelRequestButton.className = 'ui-media-dialog__cancel';
          cancelRequestButton.textContent = locale === 'de' ? 'Anfrage stornieren' : 'Cancel request';
          cancelRequestButton.addEventListener('click', async () => {
            cancelRequestButton.disabled = true;
            feedback.hidden = false;
            feedback.dataset.tone = 'neutral';
            feedback.textContent = locale === 'de' ? 'Wird storniert …' : 'Cancelling …';
            try {
              const response = await fetch('/api/media/cancel', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ mediaType: block.mediaType, tmdbId: block.tmdbId, locale }),
              });
              const data = (await response.json()) as { outcome?: string; message?: string };
              if (data.outcome === 'cancelled') {
                status.dataset.status = 'unknown';
                status.textContent = locale === 'de' ? 'storniert' : 'cancelled';
                feedback.dataset.tone = 'ok';
              } else {
                feedback.dataset.tone = 'bad';
              }
              feedback.textContent = data.message ?? (locale === 'de' ? 'Stornieren fehlgeschlagen.' : 'Cancellation failed.');
              scroll();
            } catch {
              feedback.dataset.tone = 'bad';
              feedback.textContent = locale === 'de' ? 'Die Verbindung ist fehlgeschlagen.' : 'The connection failed.';
              scroll();
            }
          });
        }

        const dismiss = document.createElement('button');
        dismiss.type = 'button';
        dismiss.className = 'ui-media-dialog__dismiss';
        dismiss.textContent = locale === 'de' ? 'Schließen' : 'Close';
        dismiss.addEventListener('click', () => dialog.close());
        if (cancelRequestButton) actions.append(cancelRequestButton);
        actions.append(dismiss);
        const feedback = document.createElement('p');
        feedback.className = 'ui-media-dialog__feedback';
        feedback.setAttribute('role', 'status');
        feedback.hidden = true;
        body.append(actions, feedback);

        content.append(poster, body);
        panel.append(hero, close, content);
        dialog.append(panel);
        document.body.append(dialog);

        const previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        const restore = (): void => {
          if (statusPollTimer !== null) {
            window.clearTimeout(statusPollTimer);
            statusPollTimer = null;
          }
          document.body.style.overflow = previousOverflow;
          dialog.remove();
          trigger.focus();
        };
        close.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener('close', restore, { once: true });
        dialog.showModal();
        close.focus();

        if (!hasRichDetails) {
          const controller = new AbortController();
          dialog.addEventListener('close', () => controller.abort(), { once: true });
          void (async () => {
            try {
              const response = await fetch(
                `/api/media/title?mediaType=${encodeURIComponent(block.mediaType)}&tmdbId=${block.tmdbId}&locale=${locale}`,
                { signal: controller.signal },
              );
              const data = (await response.json()) as { item?: AssistantBlock };
              if (data.item?.type === 'media') renderDetails(data.item);
              else details.replaceChildren();
            } catch {
              if (!controller.signal.aborted) {
                details.replaceChildren();
                const failure = document.createElement('span');
                failure.className = 'ui-media-dialog__loading';
                failure.textContent =
                  locale === 'de' ? 'Weitere Details sind gerade nicht verfügbar.' : 'More details are currently unavailable.';
                details.append(failure);
              }
            }
          })();
        }
      };

      const renderMediaCard = (
        parent: HTMLElement,
        block: AssistantBlock,
        onActivate?: (block: AssistantBlock, card: HTMLButtonElement) => void,
      ): void => {
        if (block.type !== 'media') return;
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'ui-media';
        card.dataset.status = block.status;
        card.dataset.tmdbId = String(block.tmdbId);
        card.dataset.mediaType = block.mediaType;
        card.setAttribute('aria-label', locale === 'de' ? `Details zu ${block.title}` : `Details for ${block.title}`);
        card.setAttribute('aria-haspopup', 'dialog');

        const poster = document.createElement('span');
        poster.className = 'ui-media__poster';
        const fallback = mediaFallback();
        poster.append(fallback);
        if (block.posterPath) {
          const image = document.createElement('img');
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.src = `/api/media/poster?path=${encodeURIComponent(block.posterPath)}`;
          image.addEventListener('load', () => fallback.remove());
          image.addEventListener('error', () => image.remove());
          poster.append(image);
        }
        const hint = document.createElement('span');
        hint.className = 'ui-media__hint';
        hint.textContent = locale === 'de' ? 'Details' : 'Details';
        poster.append(hint);

        const body = document.createElement('span');
        body.className = 'ui-media__body';
        const title = document.createElement('strong');
        title.className = 'ui-media__title';
        title.textContent = block.title;
        const meta = document.createElement('span');
        meta.className = 'ui-media__meta';
        meta.textContent = [
          block.year,
          block.mediaType === 'movie' ? (locale === 'de' ? 'Film' : 'Film') : locale === 'de' ? 'Serie' : 'Series',
          block.rating !== null ? `★ ${block.rating.toFixed(1)}` : '',
        ]
          .filter(Boolean)
          .join(' · ');
        const status = document.createElement('span');
        status.className = 'ui-media__status';
        status.dataset.status = block.status;
        status.textContent = block.statusText;
        body.append(title, meta, status);

        card.append(poster, body);
        card.addEventListener('click', () => {
          if (onActivate) onActivate(block, card);
          else openMediaDialog(block, card);
        });
        parent.append(card);
      };

      let batchDialogSeq = 0;

      const openBatchDialog = (
        items: readonly { block: AssistantBlock; card: HTMLButtonElement }[],
        onDone: (block: AssistantBlock, card: HTMLButtonElement, outcome: string) => void,
      ): void => {
        const dialog = document.createElement('dialog');
        dialog.className = 'ui-media-dialog ui-batch-dialog';
        const titleId = `batch-dialog-title-${++batchDialogSeq}`;
        dialog.setAttribute('aria-labelledby', titleId);
        const panel = document.createElement('div');
        panel.className = 'ui-media-dialog__panel ui-batch-dialog__panel';
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'ui-media-dialog__close';
        close.setAttribute('aria-label', locale === 'de' ? 'Schließen' : 'Close');
        close.textContent = '×';
        const body = document.createElement('div');
        body.className = 'ui-batch-dialog__body';
        const title = document.createElement('h2');
        title.id = titleId;
        title.className = 'ui-batch-dialog__title';
        title.textContent = locale === 'de' ? `${items.length} Anfragen` : `${items.length} requests`;
        const hint = document.createElement('p');
        hint.className = 'ui-batch-dialog__hint';
        hint.textContent =
          locale === 'de'
            ? 'Die Anfragen werden nacheinander gesendet; bei zu vielen Anfragen greift das Serverlimit.'
            : 'The requests are sent one after another; the server rate limit protects against bulk requests.';
        const list = document.createElement('div');
        list.className = 'ui-batch-dialog__list';
        const rows = new Map<string, HTMLElement>();
        for (const item of items) {
          if (item.block.type !== 'media') continue;
          const row = document.createElement('div');
          row.className = 'ui-batch-dialog__row';
          const poster = document.createElement('span');
          poster.className = 'ui-batch-dialog__poster';
          const fallback = mediaFallback();
          poster.append(fallback);
          if (item.block.posterPath) {
            const image = document.createElement('img');
            image.alt = '';
            image.loading = 'lazy';
            image.decoding = 'async';
            image.src = `/api/media/poster?path=${encodeURIComponent(item.block.posterPath)}`;
            image.addEventListener('load', () => fallback.remove());
            image.addEventListener('error', () => image.remove());
            poster.append(image);
          }
          const info = document.createElement('div');
          info.className = 'ui-batch-dialog__info';
          const mediaTitle = document.createElement('strong');
          mediaTitle.textContent = item.block.title;
          const meta = document.createElement('span');
          meta.textContent = [
            item.block.year,
            item.block.mediaType === 'movie' ? (locale === 'de' ? 'Film' : 'Film') : locale === 'de' ? 'Serie · alle Staffeln' : 'Series · all seasons',
          ]
            .filter(Boolean)
            .join(' · ');
          const result = document.createElement('span');
          result.className = 'ui-batch-dialog__result';
          result.textContent = locale === 'de' ? 'Bereit' : 'Ready';
          info.append(mediaTitle, meta);
          row.append(poster, info, result);
          list.append(row);
          rows.set(`${item.block.mediaType}:${item.block.tmdbId}`, result);
        }
        const actions = document.createElement('div');
        actions.className = 'ui-batch-dialog__actions';
        const request = document.createElement('button');
        request.type = 'button';
        request.className = 'ui-media-dialog__request';
        request.textContent = locale === 'de' ? 'Alle anfragen' : 'Request all';
        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'ui-media-dialog__dismiss';
        cancel.textContent = locale === 'de' ? 'Abbrechen' : 'Cancel';
        const feedback = document.createElement('p');
        feedback.className = 'ui-media-dialog__feedback';
        feedback.setAttribute('role', 'status');
        feedback.hidden = true;
        let finished = false;
        request.addEventListener('click', async () => {
          if (finished) {
            dialog.close();
            return;
          }
          request.disabled = true;
          cancel.disabled = true;
          let accepted = 0;
          let failed = 0;
          for (const item of items) {
            if (item.block.type !== 'media') continue;
            const key = `${item.block.mediaType}:${item.block.tmdbId}`;
            const rowResult = rows.get(key);
            if (rowResult) rowResult.textContent = locale === 'de' ? 'Wird angefragt …' : 'Requesting …';
            try {
              const response = await fetch('/api/media/request', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ mediaType: item.block.mediaType, tmdbId: item.block.tmdbId, locale }),
              });
              const data = (await response.json()) as { outcome?: string; message?: string };
              const ok = data.outcome === 'accepted' || data.outcome === 'already';
              if (ok) accepted += 1;
              else failed += 1;
              if (rowResult) {
                rowResult.textContent = data.message ?? data.outcome ?? '—';
                rowResult.dataset.tone = data.outcome === 'accepted' ? 'ok' : data.outcome === 'already' ? 'warn' : 'bad';
              }
              if (data.outcome === 'accepted' || data.outcome === 'already') onDone(item.block, item.card, data.outcome);
              if (data.outcome === 'rate') break;
            } catch {
              failed += 1;
              if (rowResult) {
                rowResult.textContent = locale === 'de' ? 'Verbindung fehlgeschlagen' : 'Connection failed';
                rowResult.dataset.tone = 'bad';
              }
            }
          }
          feedback.hidden = false;
          feedback.dataset.tone = failed === 0 ? 'ok' : accepted > 0 ? 'warn' : 'bad';
          feedback.textContent =
            locale === 'de'
              ? `${accepted} angefragt, ${failed} nicht abgeschlossen.`
              : `${accepted} requested, ${failed} not completed.`;
          finished = true;
          request.textContent = locale === 'de' ? 'Schließen' : 'Close';
          request.disabled = false;
          cancel.disabled = false;
          scroll();
        });
        cancel.addEventListener('click', () => dialog.close());
        close.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
        actions.append(request, cancel);
        body.append(title, hint, list, actions, feedback);
        panel.append(close, body);
        dialog.append(panel);
        document.body.append(dialog);
        const previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        const restore = (): void => {
          document.body.style.overflow = previousOverflow;
          dialog.remove();
        };
        dialog.addEventListener('close', restore, { once: true });
        dialog.showModal();
        close.focus();
      };

      const renderMediaGrid = (parent: HTMLElement, nodes: readonly AssistantBlock[]): void => {
        const media = nodes.filter((node): node is AssistantBlock => node.type === 'media');
        if (media.length === 0) return;
        if (media.length === 1) {
          const grid = document.createElement('div');
          grid.className = 'ui-media-grid';
          for (const node of media) renderMediaCard(grid, node);
          parent.append(grid);
          return;
        }

        const wrapper = document.createElement('div');
        wrapper.className = 'ui-media-batch';
        const toolbar = document.createElement('div');
        toolbar.className = 'ui-media-batch__toolbar';
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'ui-media-batch__toggle';
        toggle.textContent = locale === 'de' ? 'Mehrere auswählen' : 'Select multiple';
        toggle.setAttribute('aria-pressed', 'false');
        toolbar.append(toggle);
        const grid = document.createElement('div');
        grid.className = 'ui-media-grid';
        const bar = document.createElement('div');
        bar.className = 'ui-media-batch__bar';
        bar.hidden = true;
        const count = document.createElement('span');
        count.className = 'ui-media-batch__count';
        const request = document.createElement('button');
        request.type = 'button';
        request.className = 'ui-media-batch__request';
        request.textContent = locale === 'de' ? 'Anfragen' : 'Request';
        request.disabled = true;
        const barHint = document.createElement('span');
        barHint.className = 'ui-media-batch__hint';
        bar.append(count, barHint, request);

        let selecting = false;
        const selected = new Map<string, { block: AssistantBlock; card: HTMLButtonElement }>();
        const keyOf = (block: AssistantBlock): string =>
          block.type === 'media' ? `${block.mediaType}:${block.tmdbId}` : '';
        const sync = (): void => {
          toggle.textContent = selecting
            ? locale === 'de'
              ? 'Auswahl beenden'
              : 'End selection'
            : locale === 'de'
              ? 'Mehrere auswählen'
              : 'Select multiple';
          toggle.setAttribute('aria-pressed', String(selecting));
          bar.hidden = !selecting;
          count.textContent = locale === 'de' ? `${selected.size} ausgewählt` : `${selected.size} selected`;
          request.disabled = selected.size === 0;
          for (const card of grid.querySelectorAll<HTMLButtonElement>('.ui-media')) {
            const key = `${card.dataset.mediaType}:${card.dataset.tmdbId}`;
            const active = selected.has(key);
            card.classList.toggle('ui-media--selected', active);
            card.setAttribute('aria-pressed', String(active));
          }
        };
        const activate = (block: AssistantBlock, card: HTMLButtonElement): void => {
          if (!selecting) {
            openMediaDialog(block, card);
            return;
          }
          const key = keyOf(block);
          if (selected.has(key)) {
            selected.delete(key);
          } else {
            selected.set(key, { block, card });
          }
          sync();
        };
        for (const node of media) renderMediaCard(grid, node, activate);
        toggle.addEventListener('click', () => {
          selecting = !selecting;
          if (!selecting) selected.clear();
          barHint.textContent = '';
          sync();
        });
        request.addEventListener('click', () => {
          if (selected.size === 0) return;
          openBatchDialog([...selected.values()], (block, card) => {
            const status = card.querySelector('.ui-media__status') as HTMLElement | null;
            if (status) {
              status.dataset.status = 'requested';
              status.textContent = locale === 'de' ? 'angefragt' : 'requested';
            }
            selected.delete(keyOf(block));
            sync();
          });
        });
        wrapper.append(toolbar, grid, bar);
        parent.append(wrapper);
      };

      const renderChildren = (parent: HTMLElement, children: readonly AssistantBlock[] | undefined): void => {
        if (!Array.isArray(children)) return;
        let rowBuffer: AssistantBlock[] = [];
        let mediaBuffer: AssistantBlock[] = [];
        const flushRows = (): void => {
          if (rowBuffer.length === 0) return;
          renderRows(parent, rowBuffer);
          rowBuffer = [];
        };
        const flushMedia = (): void => {
          if (mediaBuffer.length === 0) return;
          renderMediaGrid(parent, mediaBuffer);
          mediaBuffer = [];
        };
        const flushAll = (): void => {
          flushRows();
          flushMedia();
        };
        for (const child of children) {
          if (isRowType(child)) {
            flushMedia();
            rowBuffer.push(child);
          } else if (isMediaType(child)) {
            flushRows();
            mediaBuffer.push(child);
          } else {
            flushAll();
            renderNode(parent, child);
          }
        }
        flushAll();
      };

      const renderNode = (parent: HTMLElement, block: AssistantBlock): void => {
        if (!block || typeof block !== 'object') return;

        if (block.type === 'media') {
          renderMediaGrid(parent, [block]);
          return;
        }

        if (block.type === 'stack') {
          const stack = document.createElement('div');
          stack.className = 'ui-stack';
          stack.dataset.gap = block.gap ?? 'md';
          renderChildren(stack, block.children);
          parent.append(stack);
          return;
        }

        if (block.type === 'grid') {
          const grid = document.createElement('div');
          grid.className = 'ui-grid';
          grid.dataset.columns = String(block.columns ?? 2);
          grid.dataset.gap = block.gap ?? 'md';
          renderChildren(grid, block.children);
          parent.append(grid);
          return;
        }

        if (block.type === 'card') {
          const card = document.createElement('div');
          card.className = 'ui-card';
          card.dataset.tone = block.tone ?? 'default';
          if (block.title || block.description) {
            const head = document.createElement('div');
            head.className = 'ui-card__head';
            if (block.title) {
              const title = document.createElement('h3');
              title.className = 'ui-card__title';
              title.textContent = block.title;
              head.append(title);
            }
            if (block.description) {
              const description = document.createElement('p');
              description.className = 'ui-card__description';
              description.textContent = block.description;
              head.append(description);
            }
            card.append(head);
          }
          renderChildren(card, block.children);
          parent.append(card);
          return;
        }

        if (block.type === 'section') {
          const section = document.createElement('section');
          section.className = 'ui-section';
          if (block.title) {
            const title = document.createElement('h3');
            title.className = 'ui-section__title';
            title.textContent = block.title;
            section.append(title);
          }
          if (block.description) {
            const description = document.createElement('p');
            description.className = 'ui-section__description';
            description.textContent = block.description;
            section.append(description);
          }
          renderChildren(section, block.children);
          parent.append(section);
          return;
        }

        if (block.type === 'details') {
          const details = document.createElement('details');
          details.className = 'ui-details';
          const summary = document.createElement('summary');
          summary.textContent = block.summary;
          details.append(summary);
          renderChildren(details, block.children);
          parent.append(details);
          return;
        }

        if (block.type === 'text') {
          const paragraph = document.createElement('p');
          paragraph.className = 'ui-text';
          paragraph.dataset.variant = block.variant ?? 'body';
          renderInlineWithBreaks(paragraph, block.value);
          parent.append(paragraph);
          return;
        }

        if (block.type === 'heading') {
          const heading = document.createElement(block.level === 2 ? 'h2' : block.level === 4 ? 'h4' : 'h3');
          heading.className = 'ui-heading';
          renderInline(heading, block.value);
          parent.append(heading);
          return;
        }

        if (block.type === 'list') {
          const list = document.createElement(block.ordered ? 'ol' : 'ul');
          list.className = 'ui-list';
          for (const item of block.items) {
            const entry = document.createElement('li');
            renderInline(entry, item);
            list.append(entry);
          }
          parent.append(list);
          return;
        }

        if (block.type === 'keyValue') {
          const list = document.createElement('dl');
          list.className = 'ui-kv';
          for (const item of block.items) {
            const term = document.createElement('dt');
            term.textContent = item.label;
            const value = document.createElement('dd');
            value.textContent = item.value;
            list.append(term, value);
          }
          parent.append(list);
          return;
        }

        if (block.type === 'badge') {
          const badge = document.createElement('span');
          badge.className = 'ui-badge';
          badge.dataset.tone = block.tone ?? 'neutral';
          badge.textContent = block.label;
          parent.append(badge);
          return;
        }

        if (block.type === 'callout') {
          const callout = document.createElement('div');
          callout.className = 'ui-callout';
          callout.dataset.tone = block.tone ?? 'neutral';
          if (block.title) {
            const title = document.createElement('strong');
            title.className = 'ui-callout__title';
            title.textContent = block.title;
            callout.append(title);
          }
          const text = document.createElement('p');
          renderInlineWithBreaks(text, block.text);
          callout.append(text);
          parent.append(callout);
          return;
        }

        if (block.type === 'divider') {
          const divider = document.createElement('hr');
          divider.className = 'ui-divider';
          parent.append(divider);
          return;
        }

        if (block.type === 'stat') {
          const stat = document.createElement('div');
          stat.className = 'ui-stat';
          stat.dataset.tone = block.tone ?? 'neutral';
          const label = document.createElement('span');
          label.className = 'ui-stat__label';
          label.textContent = block.label;
          const value = document.createElement('strong');
          value.className = 'ui-stat__value';
          value.textContent = block.value;
          stat.append(label, value);
          if (block.hint) {
            const hint = document.createElement('span');
            hint.className = 'ui-stat__hint';
            hint.textContent = block.hint;
            stat.append(hint);
          }
          parent.append(stat);
          return;
        }

        if (block.type === 'progress') {
          const max = block.max && block.max > 0 ? block.max : 100;
          const percent = Math.max(0, Math.min(100, Math.round((block.value / max) * 100)));
          const wrap = document.createElement('div');
          wrap.className = 'ui-progress';
          wrap.dataset.tone = block.tone ?? 'neutral';
          const head = document.createElement('div');
          head.className = 'ui-progress__head';
          const label = document.createElement('span');
          label.className = 'ui-progress__label';
          label.textContent = block.label;
          const value = document.createElement('span');
          value.className = 'ui-progress__value';
          value.textContent = block.max ? `${block.value} / ${block.max}` : `${percent}%`;
          head.append(label, value);
          const track = document.createElement('div');
          track.className = 'ui-progress__track';
          track.setAttribute('role', 'progressbar');
          track.setAttribute('aria-label', block.label);
          track.setAttribute('aria-valuemin', '0');
          track.setAttribute('aria-valuemax', String(max));
          track.setAttribute('aria-valuenow', String(Math.min(block.value, max)));
          const bar = document.createElement('div');
          bar.className = 'ui-progress__bar';
          bar.style.width = `${percent}%`;
          track.append(bar);
          wrap.append(head, track);
          if (block.hint) {
            const hint = document.createElement('span');
            hint.className = 'ui-progress__hint';
            hint.textContent = block.hint;
            wrap.append(hint);
          }
          parent.append(wrap);
          return;
        }

        if (block.type === 'chart') {
          const values = block.points.map((point) => point.value);
          const max = block.max && block.max > 0 ? block.max : Math.max(...values, 1);
          const wrap = document.createElement('div');
          wrap.className = 'ui-chart';
          wrap.dataset.tone = block.tone ?? 'neutral';
          wrap.setAttribute('role', 'img');
          wrap.setAttribute(
            'aria-label',
            [block.label, block.hint, ...block.points.map((point) => `${point.label}: ${point.value}`)].filter(Boolean).join(', '),
          );
          if (block.label) {
            const label = document.createElement('p');
            label.className = 'ui-chart__label';
            label.textContent = block.label;
            wrap.append(label);
          }

          if (block.kind === 'sparkline') {
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('viewBox', '0 0 100 32');
            svg.setAttribute('preserveAspectRatio', 'none');
            svg.setAttribute('role', 'img');
            svg.setAttribute('aria-label', block.label ?? block.hint ?? 'Verlauf');
            const points = block.points
              .map((point, index) => {
                const x = block.points.length === 1 ? 50 : (index / (block.points.length - 1)) * 100;
                const y = 30 - (point.value / max) * 26;
                return `${x.toFixed(2)},${y.toFixed(2)}`;
              })
              .join(' ');
            const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
            line.setAttribute('points', points);
            line.setAttribute('fill', 'none');
            line.setAttribute('stroke', 'currentColor');
            line.setAttribute('stroke-width', '1.6');
            line.setAttribute('stroke-linecap', 'round');
            line.setAttribute('stroke-linejoin', 'round');
            svg.append(line);
            wrap.append(svg);
          } else {
            const bars = document.createElement('div');
            bars.className = 'ui-chart__bars';
            for (const point of block.points) {
              const item = document.createElement('div');
              item.className = 'ui-chart__item';
              const track = document.createElement('div');
              track.className = 'ui-chart__track';
              const bar = document.createElement('div');
              bar.className = 'ui-chart__bar';
              bar.style.height = `${Math.max(2, (point.value / max) * 100)}%`;
              bar.title = `${point.label}: ${point.value}`;
              track.append(bar);
              const label = document.createElement('span');
              label.className = 'ui-chart__bar-label';
              label.textContent = point.label;
              item.append(track, label);
              bars.append(item);
            }
            wrap.append(bars);
          }

          if (block.hint) {
            const hint = document.createElement('span');
            hint.className = 'ui-chart__hint';
            hint.textContent = block.hint;
            wrap.append(hint);
          }
          parent.append(wrap);
          return;
        }

        if (block.type === 'timeline') {
          const timeline = document.createElement('ol');
          timeline.className = 'ui-timeline';
          for (const item of block.items) {
            const entry = document.createElement('li');
            entry.dataset.tone = item.tone ?? 'neutral';
            const mark = document.createElement('span');
            mark.className = 'ui-timeline__mark';
            mark.setAttribute('aria-hidden', 'true');
            const body = document.createElement('div');
            body.className = 'ui-timeline__body';
            const time = document.createElement('span');
            time.className = 'ui-timeline__time';
            time.textContent = item.time;
            const title = document.createElement('strong');
            title.className = 'ui-timeline__title';
            title.textContent = item.title;
            body.append(time, title);
            if (item.text) {
              const text = document.createElement('p');
              text.textContent = item.text;
              body.append(text);
            }
            entry.append(mark, body);
            timeline.append(entry);
          }
          parent.append(timeline);
          return;
        }

        if (block.type === 'table') {
          const scroll = document.createElement('div');
          scroll.className = 'ui-table-wrap';
          const table = document.createElement('table');
          table.className = 'ui-table';
          const head = document.createElement('thead');
          const headRow = document.createElement('tr');
          for (const column of block.columns) {
            const cell = document.createElement('th');
            cell.scope = 'col';
            cell.textContent = column.label;
            headRow.append(cell);
          }
          head.append(headRow);
          const body = document.createElement('tbody');
          for (const row of block.rows) {
            const tr = document.createElement('tr');
            for (const column of block.columns) {
              const cell = document.createElement('td');
              cell.textContent = row[column.key] ?? '';
              tr.append(cell);
            }
            body.append(tr);
          }
          table.append(head, body);
          scroll.append(table);
          parent.append(scroll);
          return;
        }

        if (block.type === 'link') {
          const href = safeHref(block.href);
          if (!href) return;
          const link = document.createElement('a');
          link.className = 'ui-link';
          link.href = href;
          link.textContent = block.label;
          const arrow = document.createElement('span');
          arrow.textContent = '→';
          arrow.setAttribute('aria-hidden', 'true');
          link.append(arrow);
          parent.append(link);
          return;
        }

        if (block.type === 'confirm') {
          // A confirmation replaces the search surface. Remove media cards even
          // if they arrive in a separate UI event/turn; the confirmation carries
          // its own compact film preview.
          const pruneMedia = (): void => {
            for (const media of document.querySelectorAll('.assistant__ui .ui-media')) media.remove();
            for (const grid of document.querySelectorAll('.assistant__ui .ui-media-grid')) grid.remove();
            for (const chips of document.querySelectorAll('.assistant__ui .ui-chips')) chips.remove();
          };
          pruneMedia();
          window.setTimeout(pruneMedia, 100);

          const card = document.createElement('div');
          card.className = 'ui-confirm';
          card.dataset.tone = block.tone ?? 'accent';
          const title = document.createElement('strong');
          title.className = 'ui-confirm__title';
          title.textContent = block.title;

          const preview = document.createElement('div');
          preview.className = 'ui-confirm__media';
          const poster = document.createElement('div');
          poster.className = 'ui-confirm__poster';
          const previewTitle = typeof block.mediaTitle === 'string' ? block.mediaTitle : '';
          const fallback = mediaFallback();
          poster.append(fallback);
          if (block.posterPath) {
            const image = document.createElement('img');
            image.alt = '';
            image.loading = 'lazy';
            image.decoding = 'async';
            image.src = `/api/media/poster?path=${encodeURIComponent(block.posterPath)}`;
            image.addEventListener('load', () => fallback.remove());
            image.addEventListener('load', () => fallback.remove());
          image.addEventListener('error', () => image.remove());
            poster.append(image);
          }
          const mediaBody = document.createElement('div');
          mediaBody.className = 'ui-confirm__media-body';
          const mediaTitle = document.createElement('strong');
          mediaTitle.className = 'ui-confirm__media-title';
          mediaTitle.textContent = previewTitle || (locale === 'de' ? 'Anfrage' : 'Request');
          const mediaMeta = document.createElement('span');
          mediaMeta.className = 'ui-confirm__media-meta';
          mediaMeta.textContent = [
            block.year,
            block.mediaType === 'movie'
              ? locale === 'de'
                ? 'Film'
                : 'Film'
              : block.mediaType === 'tv'
                ? locale === 'de'
                  ? 'Serie'
                  : 'Series'
                : '',
            block.mediaType === 'tv' && Array.isArray(block.seasons) && block.seasons.length > 0
              ? locale === 'de'
                ? `${block.seasons.length} Staffeln`
                : `${block.seasons.length} seasons`
              : '',
            typeof block.rating === 'number' ? `★ ${block.rating.toFixed(1)}` : '',
          ]
            .filter(Boolean)
            .join(' · ');
          const mediaStatus = document.createElement('span');
          mediaStatus.className = 'ui-media__status';
          mediaStatus.dataset.status = 'unknown';
          mediaStatus.textContent = block.statusText ?? '';
          mediaBody.append(mediaTitle, mediaMeta, mediaStatus);
          preview.append(poster, mediaBody);

          const description = document.createElement('p');
          description.className = 'ui-confirm__description';
          description.textContent = block.description;
          card.append(title, preview, description);

          if (Array.isArray(block.items) && block.items.length > 0) {
            const list = document.createElement('dl');
            list.className = 'ui-kv ui-confirm__facts';
            for (const item of block.items) {
              const term = document.createElement('dt');
              term.textContent = item.label;
              const value = document.createElement('dd');
              value.textContent = item.value;
              list.append(term, value);
            }
            card.append(list);
          }

          const actions = document.createElement('div');
          actions.className = 'ui-confirm__actions';
          const confirm = document.createElement('button');
          confirm.type = 'button';
          confirm.className = 'ui-confirm__confirm';
          confirm.textContent = block.confirmLabel;
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'ui-confirm__cancel';
          cancel.textContent = block.cancelLabel;

          const result = document.createElement('p');
          result.className = 'ui-confirm__result';
          result.setAttribute('role', 'status');
          result.hidden = true;

          const finish = (tone: string, message: string): void => {
            const selectedStatus = card.querySelector('.ui-confirm__media .ui-media__status') as HTMLElement | null;
            if (selectedStatus) {
              selectedStatus.dataset.status = tone === 'ok' ? 'requested' : selectedStatus.dataset.status;
              selectedStatus.textContent = tone === 'ok' ? (locale === 'de' ? 'angefragt' : 'requested') : selectedStatus.textContent;
            }
            result.dataset.tone = tone;
            result.textContent = message;
            result.hidden = false;
            confirm.disabled = true;
            cancel.disabled = true;
            scroll();
          };

          confirm.addEventListener('click', async () => {
            confirm.disabled = true;
            cancel.disabled = true;
            result.hidden = false;
            result.dataset.tone = 'neutral';
            result.textContent = locale === 'de' ? 'Wird angefragt …' : 'Requesting …';
            try {
              const response = await fetch('/api/media/request', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ proposalId: block.proposalId, locale }),
              });
              const data = (await response.json()) as { outcome?: string; message?: string };
              const tone =
                data.outcome === 'accepted'
                  ? 'ok'
                  : data.outcome === 'already'
                    ? 'warn'
                    : data.outcome === 'unknown'
                      ? 'warn'
                      : 'bad';
              finish(tone, data.message ?? (locale === 'de' ? 'Die Anfrage konnte nicht abgeschlossen werden.' : 'The request could not be completed.'));
            } catch {
              finish('bad', locale === 'de' ? 'Die Verbindung ist fehlgeschlagen.' : 'The connection failed.');
            }
          });

          cancel.addEventListener('click', () => {
            finish('neutral', locale === 'de' ? 'Abgebrochen.' : 'Cancelled.');
          });

          actions.append(confirm, cancel);
          card.append(actions, result);
          parent.append(card);
          return;
        }

        if (block.type === 'step') {
          if (!Array.isArray(block.options) || block.options.length === 0) return;
          const card = document.createElement('div');
          card.className = 'assistant-card assistant-card--step';
          const question = document.createElement('p');
          question.className = 'assistant-card__question';
          question.textContent = block.question;
          const options = document.createElement('div');
          options.className = 'assistant-card__options';
          for (const option of block.options) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = option.label;
            button.addEventListener('click', () => {
              if (button.disabled) return;
              for (const sibling of options.querySelectorAll('button')) sibling.disabled = true;
              button.dataset.selected = 'true';
              void send(option.label);
            });
            options.append(button);
          }
          card.append(question, options);
          if (block.step || block.total) {
            const counter = document.createElement('small');
            counter.className = 'assistant-card__counter';
            counter.textContent = `${block.step ?? 1}${block.total ? ` / ${block.total}` : ''}`;
            card.append(counter);
          }
          parent.append(card);
          return;
        }

        if (block.type === 'suggestions') {
          if (!Array.isArray(block.items) || block.items.length === 0) return;
          const options = document.createElement('div');
          options.className = 'ui-chips';
          for (const item of block.items) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = item;
            button.addEventListener('click', () => {
              button.disabled = true;
              void send(item);
            });
            options.append(button);
          }
          parent.append(options);
        }
      };

      const filtered: AssistantBlock[] = [];
      for (const node of nodes) {
        const key = blockKey(node);
        if (key) {
          if (seen.has(key)) continue;
          seen.add(key);
        }
        filtered.push(node);
      }

      let rowBuffer: AssistantBlock[] = [];
      let mediaBuffer: AssistantBlock[] = [];
      const flushRows = (): void => {
        if (rowBuffer.length === 0) return;
        renderRows(wrap, rowBuffer);
        rowBuffer = [];
      };
      const flushMedia = (): void => {
        if (mediaBuffer.length === 0) return;
        renderMediaGrid(wrap, mediaBuffer);
        mediaBuffer = [];
      };
      const flushAll = (): void => {
        flushRows();
        flushMedia();
      };
      for (const node of filtered) {
        if (isRowType(node)) {
          flushMedia();
          rowBuffer.push(node);
        } else if (isMediaType(node)) {
          flushRows();
          mediaBuffer.push(node);
        } else {
          flushAll();
          renderNode(wrap, node);
        }
      }
      flushAll();
      if (wrap.childElementCount > 0) turn.append(wrap);
      pruneMediaForConfirm();
    };

    const renderFollowUps = (turn: HTMLElement, asked: string): void => {
      // Ein Schritt oder ein Öffnen-Link ist bereits der nächste Weg.
      if (turn.querySelector('.assistant-card--step, .ui-confirm, .assistant__navigate, .ui-media-grid, .ui-chips')) return;
      const items = (config.suggestions ?? [])
        .filter((item): item is string => typeof item === 'string' && item.trim().length > 0 && item.trim() !== asked.trim())
        .slice(0, 2);
      if (items.length === 0) return;

      const wrap = document.createElement('div');
      wrap.className = 'assistant__followups';
      for (const item of items) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = item;
        button.addEventListener('click', () => {
          for (const sibling of wrap.querySelectorAll('button')) sibling.disabled = true;
          void send(item);
        });
        wrap.append(button);
      }
      turn.append(wrap);
    };

    const renderNavigations = (turn: HTMLElement, navigations: readonly Navigation[]): void => {
      if (!Array.isArray(navigations) || navigations.length === 0) return;
      const seen = new Set<string>();
      const wrap = document.createElement('div');
      wrap.className = 'assistant__navigate-row';
      for (const navigation of navigations) {
        if (!navigation || typeof navigation.label !== 'string') continue;
        const href = safeHref(navigation.href);
        if (!href || seen.has(href)) continue;
        seen.add(href);
        const link = document.createElement('a');
        link.className = 'assistant__navigate';
        link.href = href;
        link.textContent = `${labels.open ?? ''}: ${navigation.label} →`;
        wrap.append(link);
      }
      if (wrap.childElementCount > 0) turn.append(wrap);
    };

    const addUser = (value: string): void => {
      const turn = document.createElement('div');
      turn.className = 'assistant__turn assistant__turn--user';
      const paragraph = document.createElement('p');
      paragraph.textContent = value;
      turn.append(paragraph);
      log.append(turn);
      scroll();
    };

    const addAnswer = (): { turn: HTMLElement; answer: HTMLElement } => {
      const turn = document.createElement('div');
      turn.className = 'assistant__turn assistant__turn--bot';
      const answer = document.createElement('div');
      answer.className = 'assistant__answer is-streaming';
      const typing = document.createElement('span');
      typing.className = 'assistant__typing';
      typing.setAttribute('aria-label', labels.thinking ?? '');
      typing.append(document.createElement('i'), document.createElement('i'), document.createElement('i'));
      answer.append(typing);
      turn.append(answer);
      log.append(turn);
      scroll();
      return { turn, answer };
    };

    const addError = (message: string, retry: boolean): void => {
      const turn = document.createElement('div');
      turn.className = 'assistant__turn assistant__turn--bot';
      const box = document.createElement('div');
      box.className = 'assistant__error';
      const paragraph = document.createElement('p');
      paragraph.textContent = message;
      box.append(paragraph);

      if (retry) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'assistant__retry';
        button.textContent = labels.retry ?? '';
        button.addEventListener('click', () => {
          turn.remove();
          void requestAnswer();
        });
        box.append(button);
      }

      turn.append(box);
      log.append(turn);
      scroll();
    };

    const addInlineError = (turn: HTMLElement, message: string): void => {
      const box = document.createElement('div');
      box.className = 'assistant__error assistant__error--inline';
      const paragraph = document.createElement('p');
      paragraph.textContent = message;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'assistant__retry';
      button.textContent = labels.retry ?? '';
      button.addEventListener('click', () => {
        turn.remove();
        void requestAnswer();
      });
      box.append(paragraph, button);
      turn.append(box);
      scroll();
    };

    const save = (): void => {
      try {
        sessionStorage.setItem(storageKey, JSON.stringify(messages.slice(-12)));
      } catch {
        // Kein Speicher: der Verlauf bleibt in dieser Ansicht.
      }
    };

    const threadTitle = (value: string): string => {
      const title = value.replace(/\s+/g, ' ').trim().slice(0, 58);
      return title || (labels.threadUntitled ?? 'Neue Unterhaltung');
    };

    const storeThreadId = (id: string | null): void => {
      try {
        if (id) localStorage.setItem(threadStorageKey, id);
        else localStorage.removeItem(threadStorageKey);
      } catch {
        // Kein lokaler Speicher: der Server bleibt die Quelle.
      }
    };

    const ensureThread = async (firstMessage: string): Promise<boolean> => {
      if (currentThreadId) return true;
      try {
        const response = await fetch('/api/assistant/threads', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title: threadTitle(firstMessage) }),
        });
        if (!response.ok) return false;
        const data = (await response.json()) as { thread?: ThreadSummary };
        if (!data.thread?.id) return false;
        currentThreadId = data.thread.id;
        storeThreadId(currentThreadId);
        return true;
      } catch {
        return false;
      }
    };

    const persistMessages = async (entries: readonly Message[], threadId = currentThreadId): Promise<void> => {
      if (!threadId || entries.length === 0) return;
      try {
        await fetch(`/api/assistant/threads/${encodeURIComponent(threadId)}/messages`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: entries }),
        });
      } catch {
        // Der Chat bleibt nutzbar; beim nächsten Turn wird erneut gespeichert.
      }
    };

    const modelMessages = (): readonly Message[] => messages.slice(-16);

    const compactThread = async (): Promise<void> => {
      if (!currentThreadId || messages.length <= 16) return;
      try {
        await fetch(`/api/assistant/threads/${encodeURIComponent(currentThreadId)}/compact`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ locale }),
        });
      } catch {
        // Der Thread bleibt nutzbar; der nächste Turn versucht es erneut.
      }
    };

    const renderConversation = (stored: readonly Message[]): void => {
      messages = [...stored];
      intro.hidden = true;
      log.replaceChildren();
      for (const message of messages) {
        if (message.role === 'user') {
          addUser(message.content);
        } else {
          const { turn, answer } = addAnswer();
          if (message.content) {
            renderMarkdown(answer, message.content, false);
            if (!(message.ui ?? message.blocks ?? []).some((node) => node.type === 'media')) {
              renderSources(turn, message.content, (message.sources ?? []) as readonly Source[]);
            }
          } else {
            answer.remove();
          }
          renderUi(turn, message.ui ?? message.blocks ?? []);
          renderNavigations(turn, message.navigations ?? []);
        }
      }
      scroll();
    };

    const loadThread = async (id: string): Promise<void> => {
      if (busy) {
        run += 1;
        stop();
        setBusy(false);
      }
      try {
        const response = await fetch(`/api/assistant/threads/${encodeURIComponent(id)}`);
        if (!response.ok) return;
        const data = (await response.json()) as { thread?: ThreadDetail };
        if (!data.thread) return;
        currentThreadId = data.thread.id;
        storeThreadId(currentThreadId);
        renderConversation(data.thread.messages as readonly Message[]);
        void compactThread();
      } catch {
        // Der letzte lokale Stand bleibt sichtbar.
      }
    };

    const loadThreads = async (query = ''): Promise<void> => {
      if (!threadsList) return;
      try {
        const response = await fetch(`/api/assistant/threads?limit=50&q=${encodeURIComponent(query)}`);
        if (!response.ok) throw new Error('threads');
        const data = (await response.json()) as { threads?: ThreadSummary[] };
        threads = data.threads ?? [];
        renderThreads();
      } catch {
        threads = [];
        renderThreads(labels.historyError ?? '');
      }
    };

    const threadTime = (value: string): string => {
      const at = new Date(value);
      if (Number.isNaN(at.getTime())) return '';
      const today = new Date();
      const start = new Date(today.getFullYear(), today.getMonth(), today.getDate()).getTime();
      const day = at.getTime();
      if (day >= start) return at.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
      if (day >= start - 86_400_000) return labels.threadYesterday ?? '';
      return at.toLocaleDateString(locale, { day: '2-digit', month: '2-digit' });
    };

    const threadGroupLabel = (value: string): string => {
      const at = new Date(value);
      if (Number.isNaN(at.getTime())) return labels.threadOlder ?? '';
      const today = new Date();
      const start = new Date(today.getFullYear(), today.getMonth(), today.getDate()).getTime();
      if (at.getTime() >= start) return labels.threadToday ?? '';
      if (at.getTime() >= start - 86_400_000) return labels.threadYesterday ?? '';
      return labels.threadOlder ?? '';
    };

    const closeThreadMenu = (): void => {
      document.querySelectorAll('.assistant__thread-menu').forEach((menu) => menu.remove());
    };

    const renameThread = (thread: ThreadSummary, item: HTMLElement): void => {
      closeThreadMenu();
      if (item.querySelector('.assistant__thread-rename-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'assistant__thread-rename-wrap';
      const editor = document.createElement('input');
      editor.className = 'assistant__thread-rename';
      editor.value = thread.title;
      editor.setAttribute('aria-label', labels.threadRename ?? '');
      const save = document.createElement('button');
      save.type = 'button';
      save.className = 'assistant__thread-save';
      save.textContent = labels.save ?? 'Speichern';
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'assistant__thread-cancel';
      cancel.textContent = labels.cancel ?? 'Abbrechen';
      let saving = false;
      const close = (): void => wrap.remove();
      const commit = async (): Promise<void> => {
        if (saving) return;
        const title = editor.value.replace(/\s+/g, ' ').trim();
        if (!title || title === thread.title) {
          close();
          return;
        }
        saving = true;
        await fetch(`/api/assistant/threads/${encodeURIComponent(thread.id)}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title }),
        }).catch(() => undefined);
        wrap.remove();
        await loadThreads(threadsSearch?.value ?? '');
      };
      save.addEventListener('click', () => { void commit(); });
      cancel.addEventListener('click', close);
      editor.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          void commit();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          close();
        }
      });
      wrap.append(editor, save, cancel);
      item.append(wrap);
      editor.focus();
      editor.setSelectionRange(0, editor.value.length);
    };

    const deleteThread = (thread: ThreadSummary, item: HTMLElement): void => {
      closeThreadMenu();
      const confirm = document.createElement('div');
      confirm.className = 'assistant__thread-confirm';
      const question = document.createElement('span');
      question.textContent = labels.threadDeleteConfirm ?? '';
      const yes = document.createElement('button');
      yes.type = 'button';
      yes.dataset.danger = 'true';
      yes.textContent = labels.threadDelete ?? '';
      const no = document.createElement('button');
      no.type = 'button';
      no.textContent = labels.cancel ?? 'Abbrechen';
      no.addEventListener('click', () => confirm.remove());
      yes.addEventListener('click', async () => {
        await fetch(`/api/assistant/threads/${encodeURIComponent(thread.id)}`, { method: 'DELETE' }).catch(() => undefined);
        if (currentThreadId === thread.id) newConversation();
        await loadThreads(threadsSearch?.value ?? '');
      });
      confirm.append(question, yes, no);
      item.append(confirm);
    };

    const openThreadMenu = (thread: ThreadSummary, item: HTMLElement): void => {
      closeThreadMenu();
      const menu = document.createElement('div');
      menu.className = 'assistant__thread-menu';
      const rename = document.createElement('button');
      rename.type = 'button';
      rename.textContent = labels.threadRename ?? '';
      rename.addEventListener('click', () => renameThread(thread, item));
      const pin = document.createElement('button');
      pin.type = 'button';
      pin.textContent = thread.pinned ? (labels.threadUnpin ?? '') : (labels.threadPin ?? '');
      pin.addEventListener('click', async () => {
        await fetch(`/api/assistant/threads/${encodeURIComponent(thread.id)}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ pinned: !thread.pinned }),
        }).catch(() => undefined);
        closeThreadMenu();
        await loadThreads(threadsSearch?.value ?? '');
      });
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.dataset.danger = 'true';
      remove.textContent = labels.threadDelete ?? '';
      remove.addEventListener('click', () => deleteThread(thread, item));
      menu.append(rename, pin, remove);
      item.append(menu);
      window.setTimeout(() => {
        const close = (event: MouseEvent): void => {
          if (!(event.target as Element | null)?.closest('.assistant__thread-menu')) {
            closeThreadMenu();
            document.removeEventListener('click', close);
          }
        };
        document.addEventListener('click', close, { once: true });
      }, 0);
    };

    const threadRow = (thread: ThreadSummary): HTMLElement => {
      const item = document.createElement('div');
      item.className = 'assistant__thread-item';
      item.dataset.current = String(thread.id === currentThreadId);
      const open = document.createElement('button');
      open.type = 'button';
      open.className = 'assistant__thread-open';
      const main = document.createElement('span');
      main.className = 'assistant__thread-main';
      const title = document.createElement('span');
      title.className = 'assistant__thread-title';
      title.textContent = thread.title || (labels.threadUntitled ?? '');
      const preview = document.createElement('span');
      preview.className = 'assistant__thread-preview';
      preview.textContent = thread.preview || (labels.threadUntitled ?? '');
      main.append(title, preview);
      const time = document.createElement('span');
      time.className = 'assistant__thread-time';
      time.textContent = threadTime(thread.updatedAt);
      open.append(main, time);
      open.addEventListener('click', () => {
        void loadThread(thread.id);
        closeHistory();
      });
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'assistant__thread-more';
      more.textContent = '⋯';
      more.setAttribute('aria-label', labels.threadMore ?? '');
      more.addEventListener('click', (event) => {
        event.stopPropagation();
        openThreadMenu(thread, item);
      });
      item.append(open, more);
      return item;
    };

    const renderThreads = (error = ''): void => {
      if (!threadsList || !threadsEmpty) return;
      threadsList.replaceChildren();
      if (error) {
        threadsEmpty.hidden = false;
        threadsEmpty.textContent = error;
        return;
      }
      threadsEmpty.hidden = threads.length > 0;
      threadsEmpty.textContent = labels.historyEmpty ?? '';
      const groups: { label: string; items: ThreadSummary[] }[] = [];
      const pinned = threads.filter((thread) => thread.pinned);
      if (pinned.length > 0) groups.push({ label: labels.threadPinned ?? '', items: pinned });
      for (const thread of threads.filter((entry) => !entry.pinned)) {
        const label = threadGroupLabel(thread.updatedAt);
        const group = groups.find((entry) => entry.label === label);
        if (group) group.items.push(thread);
        else groups.push({ label, items: [thread] });
      }
      for (const group of groups) {
        const section = document.createElement('div');
        section.className = 'assistant__thread-group';
        const label = document.createElement('span');
        label.className = 'assistant__thread-group-label';
        label.textContent = group.label;
        section.append(label);
        for (const thread of group.items) section.append(threadRow(thread));
        threadsList.append(section);
      }
    };

    const openHistory = (): void => {
      if (!threadsPanel || !dialogPanel) return;
      threadsPanel.hidden = false;
      dialogPanel.classList.add('is-history');
      historyButton?.setAttribute('aria-expanded', 'true');
      void loadThreads();
      threadsSearch?.focus();
    };

    const closeHistory = (): void => {
      if (!threadsPanel || !dialogPanel) return;
      threadsPanel.hidden = true;
      dialogPanel.classList.remove('is-history');
      historyButton?.setAttribute('aria-expanded', 'false');
      input.focus();
    };

    const isStoredMessage = (value: unknown): value is Message => {
      if (value === null || typeof value !== 'object') return false;
      const entry = value as { role?: unknown; content?: unknown; sources?: unknown; ui?: unknown; blocks?: unknown; navigations?: unknown };
      if (entry.role !== 'user' && entry.role !== 'assistant') return false;
      if (typeof entry.content !== 'string') return false;
      if (entry.sources !== undefined && !Array.isArray(entry.sources)) return false;
      if (entry.ui !== undefined && !Array.isArray(entry.ui)) return false;
      if (entry.blocks !== undefined && !Array.isArray(entry.blocks)) return false;
      if (entry.navigations !== undefined && !Array.isArray(entry.navigations)) return false;
      return (
        entry.content.length > 0 ||
        (entry.role === 'assistant' && ((Array.isArray(entry.ui) && entry.ui.length > 0) || (Array.isArray(entry.blocks) && entry.blocks.length > 0) || (Array.isArray(entry.navigations) && entry.navigations.length > 0)))
      );
    };

    const restore = (): void => {
      let stored: Message[] = [];
      try {
        const raw = sessionStorage.getItem(storageKey);
        if (!raw) return;
        const parsed = JSON.parse(raw) as unknown;
        if (!Array.isArray(parsed)) return;
        stored = parsed.filter(isStoredMessage).slice(-12);
      } catch {
        return;
      }
      if (stored.length === 0) return;

      messages = stored;
      intro.hidden = true;
      for (const message of messages) {
        if (message.role === 'user') {
          addUser(message.content);
        } else {
          const { turn, answer } = addAnswer();
          if (message.content) {
            renderMarkdown(answer, message.content, false);
            if (!(message.ui ?? message.blocks ?? []).some((node) => node.type === 'media')) {
              renderSources(turn, message.content, message.sources ?? []);
            }
          } else {
            answer.remove();
          }
          renderUi(turn, message.ui ?? message.blocks ?? []);
          renderNavigations(turn, message.navigations ?? []);
        }
      }
      scroll();
    };

    const requestAnswer = async (): Promise<void> => {
      const last = messages[messages.length - 1];
      if (!last || last.role !== 'user' || busy) return;

      const id = ++run;
      setBusy(true);
      controller = new AbortController();
      let streamed = '';
      let sources: readonly Source[] = [];
      let uiNodes: AssistantBlock[] = [];
      let navigations: Navigation[] = [];
      let streamError = '';
      const asked = last.content;
      const turnThreadId = currentThreadId;
      const { turn, answer } = addAnswer();

      try {
        const response = await fetch('/api/assistant', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: modelMessages(), threadId: currentThreadId, locale, page }),
          signal: controller.signal,
        });

        if (!response.ok || !response.body) {
          const message =
            response.status === 401
              ? labels.signIn
              : response.status === 429
                ? labels.tooMany
                : response.status === 503
                  ? labels.unavailable
                  : labels.error;
          throw new Error(message ?? 'error');
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        const parser = new SseParser((event) => {
          try {
            if (event.event === 'sources') {
              const data = JSON.parse(event.data) as { sources?: Source[] };
              sources = data.sources ?? [];
            } else if (event.event === 'delta') {
              const data = JSON.parse(event.data) as { text?: string };
              if (typeof data.text === 'string') {
                streamed += data.text;
                scheduleStreamRender(answer, streamed);
              }
            } else if (event.event === 'ui') {
              const data = JSON.parse(event.data) as { nodes?: AssistantBlock[] };
              if (Array.isArray(data.nodes)) uiNodes.push(...data.nodes);
            } else if (event.event === 'blocks') {
              // Ältere Server-Session: derselbe Baum unter dem alten Namen.
              const data = JSON.parse(event.data) as { blocks?: AssistantBlock[] };
              if (Array.isArray(data.blocks)) uiNodes.push(...data.blocks);
            } else if (event.event === 'navigate') {
              const data = JSON.parse(event.data) as { href?: string; label?: string };
              if (typeof data.href === 'string' && typeof data.label === 'string') {
                navigations.push({ href: data.href, label: data.label });
              }
            } else if (event.event === 'error') {
              const data = JSON.parse(event.data) as { message?: string };
              streamError = data.message === 'rate' ? (labels.tooMany ?? 'error') : (labels.error ?? 'error');
            }
          } catch {
            // Ein unbekannter Rahmen wird ignoriert; der Rest des Streams zählt.
          }
        });

        for (;;) {
          const chunk = await reader.read();
          if (chunk.done) break;
          parser.push(decoder.decode(chunk.value, { stream: true }));
        }
        parser.end();

        if (streamError) throw new Error(streamError);
        if (id !== run) return;
        if (streamFrame) {
          cancelAnimationFrame(streamFrame);
          streamFrame = 0;
        }

        if (streamed.trim()) {
          renderMarkdown(answer, streamed, false);
          renderUi(turn, uiNodes);
          renderNavigations(turn, navigations);
          if (!uiNodes.some((node) => node.type === 'media')) renderSources(turn, streamed, sources);
          renderFollowUps(turn, asked);
          const assistantMessage: Message = { role: 'assistant', content: streamed.trim(), sources, ui: uiNodes, navigations };
          messages.push(assistantMessage);
          save();
          void persistMessages([assistantMessage], turnThreadId).then(() => compactThread());
        } else if (uiNodes.length > 0 || navigations.length > 0) {
          answer.remove();
          renderUi(turn, uiNodes);
          renderNavigations(turn, navigations);
          renderFollowUps(turn, asked);
          const assistantMessage: Message = { role: 'assistant', content: '', sources, ui: uiNodes, navigations };
          messages.push(assistantMessage);
          save();
          void persistMessages([assistantMessage], turnThreadId).then(() => compactThread());
        } else {
          renderMarkdown(answer, labels.empty ?? '', false);
        }
        scroll();
      } catch (error) {
        if (id !== run) return;

        if (controller.signal.aborted) {
          turn.remove();
          const stopped = document.createElement('p');
          stopped.className = 'assistant__stopped';
          stopped.textContent = labels.stopped ?? '';
          log.append(stopped);
        } else if (streamed.trim() || uiNodes.length > 0 || navigations.length > 0) {
          if (streamFrame) {
            cancelAnimationFrame(streamFrame);
            streamFrame = 0;
          }
          answer.classList.remove('is-streaming');
          try {
            if (streamed.trim()) {
              renderMarkdown(answer, streamed, false);
              renderUi(turn, uiNodes);
              renderNavigations(turn, navigations);
              if (!uiNodes.some((node) => node.type === 'media')) {
                renderSources(turn, streamed, sources);
              }
            } else {
              answer.remove();
              renderUi(turn, uiNodes);
              renderNavigations(turn, navigations);
            }
            const message =
              error instanceof Error && error.message && error.message !== labels.error
                ? error.message
                : (labels.interrupted ?? labels.error ?? '');
            addInlineError(turn, message);
          } catch {
            turn.remove();
            addError(labels.error ?? '', true);
          }
        } else {
          turn.remove();
          const message = error instanceof Error && error.message ? error.message : (labels.error ?? '');
          addError(message, true);
        }
      } finally {
        if (id === run) {
          controller = null;
          setBusy(false);
          input.focus();
          scroll();
        }
      }
    };

    const send = async (value: string): Promise<void> => {
      if (busy) return;
      await threadsReady;
      freshRequested = false;
      const trimmed = value.trim();
      if (!trimmed) return;
      const userMessage: Message = { role: 'user', content: trimmed };
      messages.push(userMessage);
      save();
      intro.hidden = true;
      addUser(trimmed);
      input.value = '';
      input.style.height = 'auto';
      const created = await ensureThread(trimmed);
      const threadId = currentThreadId;
      if (created) void persistMessages([userMessage], threadId);
      await requestAnswer();
    };

    const stop = (): void => {
      controller?.abort();
    };

    const newConversation = (): void => {
      run += 1;
      stop();
      messages = [];
      currentThreadId = null;
      freshRequested = true;
      storeThreadId(null);
      closeHistory();
      try {
        sessionStorage.removeItem(storageKey);
      } catch {
        // Kein Speicher: nichts zu löschen.
      }
      log.replaceChildren(intro);
      intro.hidden = false;
      input.value = '';
      input.style.height = 'auto';
      setBusy(false);
      input.focus();
    };

    const fitViewport = (): void => {
      if (!dialog.open) return;
      const viewport = window.visualViewport;
      if (!viewport) return;
      dialog.style.height = `${viewport.height}px`;
      dialog.style.top = `${viewport.offsetTop}px`;
    };

    const open = (query = ''): void => {
      if (!dialog.open) dialog.showModal();
      fab.setAttribute('aria-expanded', 'true');
      fab.hidden = true;
      fitViewport();
      if (!statusLoaded) {
        statusLoaded = true;
        void loadPageStatus();
      }
      if (query) {
        newConversation();
        void send(query);
      } else {
        input.focus();
        scroll();
      }
    };

    const close = (): void => dialog.close();

    document.addEventListener('click', (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>('[data-assistant-open]');
      if (!target) return;
      event.preventDefault();
      open(target.dataset.assistantQuery?.trim() ?? '');
    });

    document.addEventListener('vyrx:assistant-open', (event) => {
      const detail = (event as CustomEvent<{ query?: string }>).detail;
      open(detail?.query?.trim() ?? '');
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener('close', () => {
      fab.hidden = false;
      fab.setAttribute('aria-expanded', 'false');
      dialog.style.height = '';
      dialog.style.top = '';
      fab.focus();
    });

    document.querySelector('[data-assistant-close]')?.addEventListener('click', close);
    document.querySelector('[data-assistant-new]')?.addEventListener('click', newConversation);
    historyButton?.addEventListener('click', () => {
      if (dialogPanel?.classList.contains('is-history')) closeHistory();
      else openHistory();
    });
    threadsBack?.addEventListener('click', closeHistory);
    threadsNew?.addEventListener('click', () => {
      newConversation();
      closeHistory();
    });
    threadsSearch?.addEventListener('input', () => {
      if (historySearchTimer !== null) window.clearTimeout(historySearchTimer);
      historySearchTimer = window.setTimeout(() => {
        void loadThreads(threadsSearch.value);
      }, 180);
    });

    document.querySelectorAll<HTMLElement>('[data-assistant-suggestion]').forEach((button) => {
      button.addEventListener('click', () => {
        const question = button.textContent?.trim() ?? '';
        if (question) void send(question);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (busy) {
        stop();
        return;
      }
      void send(input.value);
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    window.visualViewport?.addEventListener('resize', fitViewport);
    window.visualViewport?.addEventListener('scroll', fitViewport);
    window.addEventListener('orientationchange', fitViewport);

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase('de') === 'j') {
        event.preventDefault();
        if (dialog.open) close();
        else open();
      }
    });

    const initializeThreads = async (): Promise<void> => {
      const savedId = (() => {
        try {
          return localStorage.getItem(threadStorageKey);
        } catch {
          return null;
        }
      })();
      try {
        const response = await fetch('/api/assistant/threads?limit=50');
        if (response.ok) {
          const data = (await response.json()) as { threads?: ThreadSummary[] };
          threads = data.threads ?? [];
          if (freshRequested || currentThreadId || messages.length > 0) return;
          const target = savedId && threads.some((thread) => thread.id === savedId) ? savedId : threads[0]?.id;
          if (target) {
            await loadThread(target);
            return;
          }
        }
      } catch {
        // Ohne Server bleibt der lokale Sitzungsverlauf.
      }
      restore();
      if (messages.length > 0) {
        const firstUser = messages.find((message) => message.role === 'user');
        if (firstUser && (await ensureThread(firstUser.content))) await persistMessages(messages);
      }
    };

    // Ohne JavaScript bleiben alle Einstiege verborgen. Erst wenn dieses
    // Skript läuft, gibt es einen Assistenten zu öffnen.
    document
      .querySelectorAll<HTMLElement>('[data-assistant-surface], [data-assistant-open]')
      .forEach((element) => {
        element.hidden = false;
      });

    threadsReady = initializeThreads();
  }
</script>

