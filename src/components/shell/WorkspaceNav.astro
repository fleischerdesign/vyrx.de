---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { isCurrent, WORKSPACE_NAV } from '@/lib/nav';
import { pathFor, routeFrom, type Locale, type RouteName } from '@/lib/locale';

interface Props {
  locale: Locale;
  isAdmin: boolean;
  /** Für das Aktiv-Zeichen, wenn die Adresse nicht schon die Ansicht verrät. */
  current?: RouteName;
}

const { locale, isAdmin, current } = Astro.props;
const t = useTranslations(locale);
const here = current ?? routeFrom(Astro.url.pathname).name;
const items = WORKSPACE_NAV.filter((item) => !item.admin || isAdmin);
---

<nav class="ws-nav" aria-label={t('workspaceLabel')}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={pathFor(locale, item.name)}
            class:list={['ws-nav__item', isCurrent(item, here) && 'is-current']}
            aria-current={isCurrent(item, here) ? 'page' : undefined}
          >
            <Icon name={item.icon} size="1.1rem" />
            <span>{t(item.key)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .ws-nav ul {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .ws-nav__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    color: #a7aebe;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .ws-nav__item:hover {
    background: rgb(255 255 255 / 0.07);
    color: #fff;
  }

  .ws-nav__item.is-current {
    background: #33304e;
    color: #fff;
  }

  .ws-nav__item.is-current :global(svg) {
    color: #aaa4ff;
  }
</style>
