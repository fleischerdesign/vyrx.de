---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { isCurrent, WORKSPACE_NAV } from '@/lib/nav';
import { pathFor, routeFrom, type Locale, type RouteName } from '@/lib/locale';

interface Props {
  locale: Locale;
  isAdmin: boolean;
  /** Für das Aktiv-Zeichen, wenn die Adresse nicht schon die Ansicht verrät. */
  current?: RouteName;
  attentionCount?: number;
}

const { locale, isAdmin, current, attentionCount = 0 } = Astro.props;
const t = useTranslations(locale);
const here = current ?? routeFrom(Astro.url.pathname).name;
const items = WORKSPACE_NAV.filter((item) => !item.admin || isAdmin);
---

<nav class="ws-nav" aria-label={t('workspaceLabel')}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={pathFor(locale, item.name)}
            class:list={['ws-nav__item', isCurrent(item, here) && 'is-current']}
            aria-current={isCurrent(item, here) ? 'page' : undefined}
            aria-label={t(item.key)}
          >
            <Icon name={item.icon} size="1.1rem" />
            <span>{t(item.key)}</span>
            {item.name === 'status' && attentionCount > 0 && (
              <span class="ws-nav__badge" aria-label={`${t('navStatus')}: ${attentionCount}`}>
                {attentionCount}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .ws-nav ul {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .ws-nav__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--panel-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .ws-nav__item:hover {
    background: var(--panel-hover);
    color: var(--panel-on);
  }

  .ws-nav__item.is-current {
    background: rgb(170 164 255 / 0.1);
    color: var(--panel-on);
  }

  .ws-nav__item.is-current::before {
    content: '';
    position: absolute;
    inset-block: 8px;
    inset-inline-start: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--panel-accent);
  }

  .ws-nav__item.is-current :global(svg) {
    color: var(--panel-accent);
  }

  .ws-nav__badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    margin-inline-start: auto;
    padding-inline: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--panel-badge);
    color: var(--panel-on);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1;
  }
</style>
