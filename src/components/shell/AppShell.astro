---
// The one shell. Landing and app are two states of it, not two designs: `data-auth` decides which chrome
// is visible, and the slot holds the landing for a visitor and the views for a signed-in person.
//
// Every address in here comes from the route table, and every entry that is the page's own carries
// `aria-current` from the server - a client that has not run yet cannot be the only thing that knows where
// the reader is. The language switch points at the *same view* in the other language, so switching a
// language is not going home; a selected service is carried into that address by the client, because a
// prerendered file cannot know the query it was opened with.
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n';
import { NAV, PRIMARY_NAV } from '../../lib/nav.ts';
import { icon } from '../../lib/icons.ts';
import { LOCALES, loginPathFor, pathFor } from '../../lib/routes.ts';
import type { Route } from '../../lib/routes.ts';

interface Props {
  locale: Locale;
  /** The view this page is. Absent on a miss, which is why nothing is marked as current there. */
  route?: Route['name'];
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
// Signing in returns to this page, not to the start page.
const loginUrl = loginPathFor(locale, route);

const home = pathFor(locale, 'overview');
---

<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content" href="#main">{t.skipToContent}</a>

<div class="drawer lg:drawer-open" id="shell-drawer">
  <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex min-h-screen flex-col">
    <header class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100/85 backdrop-blur">
      <div class="navbar-start">
        <label for="nav-drawer" class="btn btn-square btn-ghost hidden md:inline-flex lg:hidden" aria-label={t.navOverview} data-auth="in" hidden><Fragment set:html={icon('menu')} /></label>
        <a href={home} class="btn btn-ghost px-2 text-lg font-extrabold tracking-[0.2em]">
          VYRX<span class="text-primary">.</span>
        </a>
      </div>

      <div class="navbar-center hidden md:flex" data-auth="in" hidden>
        <button type="button" class="btn btn-ghost w-80 justify-start font-normal" data-action="palette">
          <Fragment set:html={icon('search')} /><span>{t.searchPlaceholder}</span>
          <kbd class="kbd kbd-sm ml-auto" aria-hidden="true">⌘K</kbd>
        </button>
      </div>

      <div class="navbar-end gap-2">
        <div class="join" data-auth="out">
          {
            LOCALES.map((target) => (
              <a
                href={pathFor(target, route ?? 'overview')}
                hreflang={target}
                data-locale-switch={target}
                class={`btn btn-sm join-item${target === locale ? ' btn-active' : ''}`}
                aria-current={target === locale ? 'true' : undefined}
                >{target.toUpperCase()}</a
              >
            ))
          }
        </div>
        <a href={loginUrl} class="btn btn-sm btn-primary" data-auth="out">{t.workspaceLogin}</a>

        <div class="dropdown dropdown-end" data-auth="in" hidden>
          <div tabindex="0" role="button" class="btn btn-circle btn-ghost" aria-label={t.navAccount}>
            <span class="avatar avatar-placeholder">
              <span class="grid w-8 place-items-center rounded-full bg-primary text-primary-content" data-field="initial">U</span>
            </span>
          </div>
          <ul tabindex="0" class="dropdown-content menu z-50 mt-2 w-52 rounded-box bg-base-100 p-2 shadow-xl">
            <li class="menu-title"><span data-field="username"></span></li>
            <li><a href={pathFor(locale, 'account')}>{t.navAccount}</a></li>
            <li><a href="/outpost.goauthentik.io/sign_out">{t.logout}</a></li>
          </ul>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 p-4 md:p-6">
      <slot />
    </main>

    <nav class="dock dock-md border-t border-base-300 bg-base-100 md:hidden" aria-label={t.navOverview} data-auth="in" hidden>
      {
        PRIMARY_NAV.map((item) => (
          <a href={pathFor(locale, item.name)} aria-current={route === item.name ? 'page' : undefined}>
            <Fragment set:html={icon(item.icon)} />
            <span class="dock-label">{t[item.key]}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="drawer-side z-40">
    <label for="nav-drawer" class="drawer-overlay" aria-label={t.back}></label>
    <aside class="min-h-full w-64 bg-base-200 p-2">
      <ul class="menu w-full" data-auth="in" hidden>
        {
          NAV.map((item) => (
            <li>
              <a href={pathFor(locale, item.name)} aria-current={route === item.name ? 'page' : undefined}>
                <Fragment set:html={icon(item.icon)} />{t[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</div>

<div class="toast toast-end z-50" id="toast-region"></div>
