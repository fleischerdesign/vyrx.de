---
import { useTranslations } from '@/i18n';
import { LOCALES, pathFor, routeFrom, type Locale } from '@/lib/locale';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
const here = routeFrom(Astro.url.pathname);
---

<div class={`locale ${className ?? ''}`} role="group" aria-label={t('languageSwitch')}>
  {
    LOCALES.map((target) => (
      <a
        href={pathFor(target, here.name, here.param ?? undefined)}
        hreflang={target}
        class:list={['locale__item', target === locale && 'is-current']}
        aria-current={target === locale ? 'true' : undefined}
      >
        {target.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  .locale {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  .locale__item {
    padding: 0.5rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--muted);
  }

  .locale__item + .locale__item {
    border-left: 1px solid var(--line);
  }

  .locale__item.is-current {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .locale__item:hover {
    color: var(--accent);
  }
</style>
