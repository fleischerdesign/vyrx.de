---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n';
import '../styles/app.css';

const { locale } = Astro.props;
const t = useTranslations(locale);

// Every auth entry points at the same-origin outpost, never at auth.vyrx.de: forward-auth is decided by
// the outpost cookie on *this* host. One constant, so nothing here drifts apart.
const loginUrl = '/outpost.goauthentik.io/start?rd=/';
const accountUrl = 'https://auth.vyrx.de/if/user/';
---

<Layout locale={locale}>
  <!-- Public landing. It stays exactly as it is for anonymous visitors; the app replaces it only once
       /api/me confirms a session, so the first paint is never a spinner. -->
  <div id="landing">
    <div class="container">
      <header>
        <a href={locale === 'en' ? '/en/' : '/'} class="brand">
          <div class="brand-logo">
            <span>VYRX</span>
            <span class="brand-dot"></span>
          </div>
        </a>

        <div class="header-actions">
          <div class="lang-switcher">
            <a href="/" class={`lang-btn${locale === 'de' ? ' active' : ''}`}>DE</a>
            <a href="/en/" class={`lang-btn${locale === 'en' ? ' active' : ''}`}>EN</a>
          </div>

          <div class="mesh-badge">
            <span class="live-dot"></span>
            <span id="mesh-status-text">MESH 10.10.100.0/24</span>
          </div>

          <a href={loginUrl} class="btn-login" id="login-action-btn">
            <span>{t.workspaceLogin}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </header>

      <main class="hero">
        <div class="hero-eyebrow">
          <span>{t.eyebrow}</span>
        </div>

        <h1>{t.heroTitlePrefix}<br>{t.heroTitleSuffix}</h1>

        <p class="hero-p">
          {t.heroDescription}
        </p>

        <div class="hero-actions">
          <a href={loginUrl} class="btn-primary">
            <span>{t.openWorkspace}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <div class="auth-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>{t.authProtection}</span>
          </div>
        </div>
      </main>

      <div class="section-header">
        <div>
          <div class="section-title">
            <span>{t.meshSectionTitle}</span>
          </div>
          <div class="section-desc">{t.meshSectionDesc}</div>
        </div>
      </div>

      <div class="mesh-monitor">
        <table class="monitor-table">
          <thead>
            <tr>
              <th>{t.tableColHost}</th>
              <th>{t.tableColZone}</th>
              <th>{t.tableColAddress}</th>
              <th>{t.tableColServices}</th>
            </tr>
          </thead>
          <!-- The fleet inventory is derived from the topology and rendered by the page from the same
               registry the app reads; there is no mesh.json to drift. -->
          <tbody id="hosts-body"></tbody>
        </table>
      </div>

      <footer>
        <div>
          {t.footerPlatform}
        </div>
        <div class="footer-links">
          <a href="https://github.com/fleischerdesign/nixfiles" target="_blank" rel="noreferrer">{t.gitopsFlake}</a>
          <a href="/.well-known/security.txt">{t.securityPolicy}</a>
          <a href="https://auth.vyrx.de">{t.ssoPortal}</a>
        </div>
      </footer>
    </div>
  </div>

  <a class="skip-link" href="#main">{t.skipToContent}</a>
  <div class="app" id="app" data-locale={locale}></div>

  <script>
    import { boot } from '../lib/app.js';
    import de from '../i18n/de.json';
    import en from '../i18n/en.json';

    const node = document.getElementById('app');
    const locale = node?.dataset.locale === 'en' ? 'en' : 'de';
    boot({
      messages: locale === 'en' ? en : de,
      locale,
      loginUrl: '/outpost.goauthentik.io/start?rd=/',
      accountUrl: 'https://auth.vyrx.de/if/user/',
    });
  </script>
</Layout>
