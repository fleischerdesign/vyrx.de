---
import Layout from '../layouts/Layout.astro';
import AppShell from './shell/AppShell.astro';
import { useTranslations } from '../i18n';

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale}>
  <AppShell locale={locale}>
    <section class="hero rounded-box border border-base-300 bg-base-200 py-14">
      <div class="hero-content text-center">
        <div class="max-w-2xl">
          <span class="badge badge-ghost mb-4">{t.eyebrow}</span>
          <h1 class="text-4xl font-bold sm:text-5xl">
            {t.heroTitlePrefix}<br /><span class="text-primary">{t.heroTitleSuffix}</span>
          </h1>
          <p class="py-6 opacity-70">{t.heroDescription}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="/outpost.goauthentik.io/start?rd=/" class="btn btn-primary">
              {t.openWorkspace}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            <span class="badge badge-outline badge-lg gap-2">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              {t.authProtection}
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="mt-10 mb-3 flex flex-wrap items-baseline gap-3">
      <h2 class="text-lg font-semibold">{t.meshSectionTitle}</h2>
      <span class="text-sm opacity-50">{t.meshSectionDesc}</span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" id="hosts-grid"></div>

    <footer class="footer footer-horizontal mt-12 border-t border-base-300 pt-6 text-sm">
      <aside><p class="opacity-60">{t.footerPlatform}</p></aside>
      <nav>
        <a class="link link-hover" href="https://github.com/fleischerdesign/nixfiles" target="_blank" rel="noreferrer">{t.gitopsFlake}</a>
        <a class="link link-hover" href="/.well-known/security.txt">{t.securityPolicy}</a>
        <a class="link link-hover" href="https://auth.vyrx.de">{t.ssoPortal}</a>
      </nav>
    </footer>
  </AppShell>

  <script>
    import { boot } from '../lib/app.ts';
    import { useTranslations } from '../i18n';

    const locale = document.documentElement.lang === 'en' ? 'en' : 'de';
    boot({
      // The same accessor the markup uses: on the client too, a key missing from a table is marked in
      // the page instead of arriving as an empty string - which is how `statusNodes` could sit blank
      // on two views. `t` from the frontmatter is not in scope here.
      messages: useTranslations(locale),
      locale,
      loginUrl: '/outpost.goauthentik.io/start?rd=/',
      accountUrl: 'https://auth.vyrx.de/if/user/',
    });
  </script>
</Layout>
