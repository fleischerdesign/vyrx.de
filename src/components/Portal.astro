---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n';
import meshData from '../data/mesh.json';
import appsData from '../data/apps.json';

const { locale } = Astro.props;
const t = useTranslations(locale);

// Presentation stays here; the facts (which service exists, its URL, its audience) come from the
// contracts as /portal.json. Keyed by the same id the compiler derives from the service name.
const presentation = Object.fromEntries(
  appsData.map((app) => [app.id, { desc: app.desc[locale], badge: app.badge[locale] }]),
);
---

<Layout locale={locale}>
  <div class="container">
    <!-- Navbar -->
    <header>
      <a href={locale === "en" ? "/en/" : "/"} class="brand">
        <div class="brand-logo">
          <span>VYRX</span>
          <span class="brand-dot"></span>
        </div>
      </a>

      <div class="header-actions">
        <!-- Language Switcher -->
        <div class="lang-switcher">
          <a href="/" class={`lang-btn${locale === "de" ? " active" : ""}`}>DE</a>
          <a href="/en/" class={`lang-btn${locale === "en" ? " active" : ""}`}>EN</a>
        </div>

        <div class="mesh-badge">
          <span class="live-dot"></span>
          <span id="mesh-status-text">MESH 10.10.100.0/24</span>
        </div>

        <!-- Default: Login Button -->
        <a href="https://auth.vyrx.de" class="btn-login" id="login-action-btn">
          <span>{t.workspaceLogin}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>

        <!-- Authenticated State: User Pill (populated client-side without layout shift) -->
        <div class="user-pill" id="user-profile-pill">
          <div class="user-avatar" id="user-avatar-initial">U</div>
          <span class="user-name" id="user-display-name">User</span>
          <a href="https://auth.vyrx.de/flows/-/default/invalidation/" class="user-logout" title={t.logout}>✕</a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <main class="hero">
      <div class="hero-eyebrow">
        <span>{t.eyebrow}</span>
      </div>

      <h1>{t.heroTitlePrefix}<br>{t.heroTitleSuffix}</h1>

      <p class="hero-p">
        {t.heroDescription}
      </p>

      <div class="hero-actions">
        <a href="https://auth.vyrx.de" class="btn-primary">
          <span>{t.openWorkspace}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <div class="auth-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>{t.authProtection}</span>
        </div>
      </div>
    </main>

    <!-- 1. Infrastructure & Mesh Nodes -->
    <div class="section-header">
      <div>
        <div class="section-title">
          <span>{t.meshSectionTitle}</span>
        </div>
        <div class="section-desc">{t.meshSectionDesc}</div>
      </div>
    </div>

    <div class="mesh-monitor">
      <table class="monitor-table">
        <thead>
          <tr>
            <th>{t.tableColHost}</th>
            <th>{t.tableColZone}</th>
            <th>{t.tableColAddress}</th>
            <th>{t.tableColServices}</th>
          </tr>
        </thead>
        <tbody>
          {meshData.nodes.map((node) => (
            <tr class="monitor-row">
              <td>
                <div class="node-ident">
                  <div class="node-status-pulse pulse-online" title="Online / Active"></div>
                  <div class="node-title-group">
                    <div class="node-hostname">
                      <span>{node.name}</span>
                      <span class="node-zone-tag">{node.hardware}</span>
                    </div>
                    <div class="node-role-desc">{node.role[locale]}</div>
                  </div>
                </div>
              </td>
              <td>
                <div class="node-hardware">{node.zone}</div>
              </td>
              <td>
                <span class="node-ip-badge">{node.address}</span>
              </td>
              <td>
                <div class="node-stack-pills">
                  {node.services.map((svc) => (
                    <span class="stack-pill">{svc}</span>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 2. Applications & Services (from the contracts; hidden until the visitor is authenticated).
         An anonymous visitor sees no tile at all: a service the visitor may not use is not shown,
         not greyed out. -->
    <div id="portal-section" style="display: none">
      <div class="section-header">
        <div>
          <div class="section-title">
            <span>{t.appsSectionTitle}</span>
          </div>
          <div class="section-desc">{t.appsSectionDesc}</div>
        </div>
      </div>

      <section class="app-grid" id="app-grid"></section>
    </div>

    <!-- Footer -->
    <footer>
      <div>
        {t.footerPlatform}
      </div>
      <div class="footer-links">
        <a href="https://github.com/fleischerdesign/nixfiles" target="_blank" rel="noreferrer">{t.gitopsFlake}</a>
        <a href="/.well-known/security.txt">{t.securityPolicy}</a>
        <a href="https://auth.vyrx.de">{t.ssoPortal}</a>
      </div>
    </footer>
  </div>

  <script is:inline define:vars={{ presentation, launchLabel: t.launchApp }}>
    (async () => {
      const escapeHtml = (value) =>
        String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      // 1. Identity: same-origin, so no CORS and no cross-site cookie. forward_auth answers with the
      //    X-Portal-* headers on success; without a session it returns the outpost's redirect, which
      //    `redirect: 'manual'` surfaces as an opaque response -> anonymous.
      let identity = null;
      try {
        const res = await fetch('/api/me', {
          credentials: 'same-origin',
          redirect: 'manual',
          headers: { Accept: 'application/json' },
        });
        if (res.ok && res.type !== 'opaqueredirect') {
          const groups = (res.headers.get('X-Portal-Groups') || '')
            .split('|')
            .map((g) => g.trim())
            .filter(Boolean);
          identity = {
            username: res.headers.get('X-Portal-Username') || '',
            name: res.headers.get('X-Portal-Name') || '',
            groups,
          };
        }
      } catch (_) {
        identity = null;
      }

      if (!identity) return;

      const loginBtn = document.getElementById('login-action-btn');
      const pill = document.getElementById('user-profile-pill');
      if (loginBtn) loginBtn.style.display = 'none';
      if (pill) {
        pill.style.display = 'inline-flex';
        const label = identity.name || identity.username || 'U';
        document.getElementById('user-display-name').textContent = label;
        document.getElementById('user-avatar-initial').textContent = label.charAt(0).toUpperCase();
      }

      // 2. Applications: the list and the URL are the contracts'; a service is shown only when the
      //    visitor's groups intersect the audience the ingress enforces.
      let apps = [];
      try {
        apps = await (await fetch('/portal.json', { credentials: 'same-origin' })).json();
      } catch (_) {
        apps = [];
      }
      const visible = apps.filter(
        (app) => !app.groups || app.groups.length === 0 || app.groups.some((g) => identity.groups.includes(g)),
      );

      const grid = document.getElementById('app-grid');
      const section = document.getElementById('portal-section');
      if (!grid || !section || visible.length === 0) return;

      grid.innerHTML = visible
        .map((app) => {
          const local = presentation[app.id] || {};
          return `<a href="${escapeHtml(app.url)}" class="app-card">
            <div>
              <div class="app-top">
                <div class="app-icon">${escapeHtml(app.name.charAt(0))}</div>
                <span class="app-badge">${escapeHtml(local.badge || app.category)}</span>
              </div>
              <div class="app-title">${escapeHtml(app.name)}</div>
              <div class="app-desc">${escapeHtml(local.desc || '')}</div>
            </div>
            <div class="app-footer">
              <span class="app-url">${escapeHtml(app.url.replace('https://', ''))}</span>
              <span class="app-action">${escapeHtml(launchLabel)} →</span>
            </div>
          </a>`;
        })
        .join('');
      section.style.display = 'block';
    })();
  </script>
</Layout>

<style is:global>
  .app-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
