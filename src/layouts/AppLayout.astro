---
// A page of the portal: the document, the shell, the view and the one script that makes the live parts live.
//
// The shell is a layout now and not something every page assembles (S2), so a page below this file carries
// content and nothing else - no navigation, no footer, no palette, no language switch.
//
// The slot holds the *file*: `StaticView` renders what belongs to everyone, which is what a reader without
// a script (or with one, before it has run) sees. A page that has content of its own - the start page with
// its landing - fills the slot itself.
import Layout from './Layout.astro';
import AppShell from '../components/shell/AppShell.astro';
import StaticView from '../components/view/StaticView.astro';
import type { Locale } from '../i18n';
import type { Route } from '../lib/routes.ts';

interface Props {
  locale: Locale;
  route: Route['name'];
}

const { locale, route } = Astro.props;
---

<Layout locale={locale} route={route}>
  <AppShell locale={locale} route={route}>
    <slot>
      <StaticView locale={locale} route={route} />
    </slot>
  </AppShell>
</Layout>

<script>
  import { boot } from '../lib/app.ts';
  import { useTranslations } from '../i18n';
  import { ACCOUNT_URL, routeFrom } from '../lib/routes.ts';

  // The address is the only input the client has, and it reads it through the same table the server used:
  // two derivations of one fact would be one too many - including where a sign-in comes back to.
  const { locale, route, selected } = routeFrom(location.pathname, location.search);
  boot({
    // The same accessor the markup uses: on the client too, a key missing from a table is marked in
    // the page instead of arriving as an empty string.
    messages: useTranslations(locale),
    locale,
    route,
    selected,
    accountUrl: ACCOUNT_URL,
  });
</script>
