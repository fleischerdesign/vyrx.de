---
// The document: one `<html>`, one head, one icon sprite.
//
// Everything in the head that names *this page* comes from the route table - title, description, canonical
// address and the alternates that point at the other language. Before, the head carried the site's title
// and one canonical for every address, which was true for exactly two pages.
import '../styles/daisy.css';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
// The sprite carries every icon in this document: the shell and the client views reference the same
// `<symbol>`s, so an icon cannot differ between the two renderers.
import IconSprite from '../components/IconSprite.astro';
import { LOCALES, pathFor, routeFor } from '../lib/routes';
import type { Route } from '../lib/routes';
import { THEMES, THEME_KEY } from '../lib/theme.ts';

interface Props {
  locale: Locale;
  /** The view this document is. Absent means the address is a miss, and a miss is not an address. */
  route?: Route['name'];
  /** The service, when this document is a service page: part of its address, so part of its canonical. */
  id?: string | null;
}

const { locale, route, id = null } = Astro.props;
const t = useTranslations(locale);
const definition = route ? routeFor(route) : undefined;
const label = definition ? t[definition.key] : '';
const title = route && route !== 'overview' && label ? `${label} · VYRX` : t.siteTitle;
const description = (definition?.descKey ? t[definition.descKey] : '') || t.siteDesc;
const absolute = (target: Locale) =>
  new URL(pathFor(target, id ? 'detail' : route ?? 'overview', id ?? undefined), Astro.site).href;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  {
    /* Before the stylesheet, before the body, before anything is painted: the stored appearance choice
       onto the document, and the mark that says a script runs at all. Both are facts about *this*
       document, and a choice applied after the first paint would be a flash on every navigation. The key
       and the two values come from `lib/theme.ts`, so the script cannot drift from the module. */
  }
  <script is:inline define:vars={{ themeKey: THEME_KEY, themes: THEMES }}>
    try {
      const stored = localStorage.getItem(themeKey);
      if (themes.includes(stored)) document.documentElement.dataset.theme = stored;
    } catch {
      // No storage: the system preference stays the answer.
    }
    document.documentElement.classList.add('js');
  </script>

  <!-- The mark set. Every file here is built from one artwork by `docs/brand/build.py`; the browser gets a
       glyph at 16 px and the name where there is room for it. `theme-color` follows the system, because
       the portal itself follows it (G2) - the manifest cannot, being one file. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1d232a" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="VYRX" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={locale} />

  {
    route ? (
      <>
        <link rel="canonical" href={absolute(locale)} />
        <meta property="og:url" content={absolute(locale)} />
        {LOCALES.map((other) => <link rel="alternate" hreflang={other} href={absolute(other)} />)}
        <link rel="alternate" hreflang="x-default" href={absolute('de')} />
      </>
    ) : (
      // A page without an address of its own must not be indexed as one.
      <meta name="robots" content="noindex" />
    )
  }

  <!-- Typography comes from the platform stack until the fonts are self-hosted; daisyUI carries the rest. -->
</head>
<body>
  <IconSprite />
  <slot />
</body>
</html>
