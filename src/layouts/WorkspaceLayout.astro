---
/*
 * Die Hülle des angemeldeten Bereichs: eine dunkle Seitenleiste, eine ruhige
 * Kopfzeile und der Inhalt. Mobil tritt die Seitenleiste zurück und eine
 * untere Leiste übernimmt die Navigation.
 */
import Base from './Base.astro';
import SkipLink from '@/components/shell/SkipLink.astro';
import ThemeToggle from '@/components/shell/ThemeToggle.astro';
import LocaleSwitch from '@/components/shell/LocaleSwitch.astro';
import WorkspaceNav from '@/components/shell/WorkspaceNav.astro';
import MobileDock from '@/components/shell/MobileDock.astro';
import CommandPalette, { type PaletteItem } from '@/components/shell/CommandPalette.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { isCurrent, WORKSPACE_NAV } from '@/lib/nav';
import { routeFrom, pathFor, type Locale } from '@/lib/locale';
import { text } from '@/lib/fleet';
import { articlesFor, articleSlug, canReadArticle } from '@/lib/knowledge';
import type { Session } from '@/lib/session';

interface Props {
  locale: Locale;
  session: Session;
  title: string;
  description: string;
}

const { locale, session, title, description } = Astro.props;
const t = useTranslations(locale);
const here = routeFrom(Astro.url.pathname).name;
const currentItem = WORKSPACE_NAV.find((item) => isCurrent(item, here));
const identity = session.identity;
const initial = (identity?.name || identity?.username || 'U').charAt(0).toUpperCase();

// Die Suche bekommt genau das, was diese Person sehen darf - serverseitig gebaut.
const prefix = locale === 'en' ? '/en' : '';
const articles = (await articlesFor(locale)).filter((article) => canReadArticle(article, session.identity));
const palette: PaletteItem[] = [
  ...WORKSPACE_NAV.filter((item) => !item.admin || session.isAdmin).map((item) => ({
    group: 'nav' as const,
    label: t(item.key),
    href: pathFor(locale, item.name),
  })),
  ...session.services.map((service) => ({
    group: 'services' as const,
    label: text(service.name, locale),
    hint: text(service.summary, locale),
    href: `${prefix}/services/${service.id}/`,
  })),
  ...articles.map((article) => ({
    group: 'knowledge' as const,
    label: article.data.title,
    hint: article.data.summary,
    href: `${prefix}/knowledge/${articleSlug(article)}/`,
  })),
];
---

<Base locale={locale} title={title} description={description} noindex>
  <SkipLink locale={locale} />

  <div class="shell">
    <aside class="side">
      <a class="side__brand" href={`/${locale === 'en' ? 'en/' : ''}`} aria-label={t('brandHome')}>
        <Wordmark height="1.3rem" />
      </a>

      <p class="side__label">{t('workspaceLabel')}</p>
      <WorkspaceNav locale={locale} isAdmin={session.isAdmin} current={here} />

      <div class="side__bottom">
        <p class="side__label">{t('yourAccess')}</p>
        <div class="side__user">
          <span class="side__avatar" aria-hidden="true">{initial}</span>
          <span class="side__user-text">
            <strong>{identity?.name || identity?.username}</strong>
            <small>{t('personalSpace')}</small>
          </span>
        </div>
        <a class="side__logout" href="/outpost.goauthentik.io/sign_out">
          <Icon name="lock" size="1rem" />
          {t('logout')}
        </a>
      </div>
    </aside>

    <div class="content">
      <header class="topbar">
        <a class="topbar__brand" href={`/${locale === 'en' ? 'en/' : ''}`} aria-label={t('brandHome')}>
          <Wordmark height="1.15rem" />
        </a>
        <nav class="crumb" aria-label={t('workspaceLabel')}>
          <span>{t('workspaceLabel')}</span>
          <span aria-hidden="true">/</span>
          <strong>{currentItem ? t(currentItem.key) : t('navOverview')}</strong>
        </nav>
        <div class="topbar__actions">
          <span class="palette-slot"><CommandPalette locale={locale} items={palette} /></span>
          <LocaleSwitch locale={locale} class="topbar__locale" />
          <ThemeToggle locale={locale} />
        </div>
      </header>

      <main id="main" tabindex="-1" class="main">
        <slot />
      </main>
    </div>
  </div>

  <MobileDock locale={locale} isAdmin={session.isAdmin} />
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    min-height: 100dvh;
  }

  .side {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--space-8) var(--space-4) var(--space-6);
    background: var(--panel);
    color: #f3f4f7;
  }

  .side__brand {
    margin: var(--space-1) var(--space-4) var(--space-10);
    color: #fff;
  }

  .side__label {
    margin: 0 var(--space-4) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #7f879b;
  }

  .side__bottom {
    margin-top: auto;
    border-top: 1px solid #343946;
    padding-top: var(--space-5);
  }

  .side__user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .side__avatar {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-sm);
    background: #393e50;
    color: #eaeaf0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    flex: none;
  }

  .side__user-text strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .side__user-text small {
    display: block;
    color: #9299a9;
    font-size: var(--text-xs);
    margin-top: 1px;
  }

  .side__logout {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: #a7aebe;
    font-size: var(--text-sm);
  }

  .side__logout:hover {
    color: #fff;
  }

  .content {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 70px;
    padding-inline: clamp(var(--space-4), 4vw, var(--space-12));
    background: color-mix(in srgb, var(--surface-2) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .topbar__brand {
    display: none;
    color: var(--ink);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .crumb strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  .topbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .palette-slot {
    display: none;
  }

  @media (min-width: 901px) {
    .palette-slot {
      display: block;
    }
  }

  .main {
    flex: 1;
    padding: var(--space-12) clamp(var(--space-4), 4vw, var(--space-12)) var(--space-24);
  }

  @media (max-width: 900px) {
    .shell {
      display: block;
    }

    .side {
      display: none;
    }

    .topbar__brand {
      display: block;
    }

    .crumb {
      display: none;
    }

    .main {
      padding-bottom: calc(var(--space-24) + 4rem);
    }
  }
</style>
