---
/*
 * Die Hülle des angemeldeten Bereichs: eine dunkle Seitenleiste, eine ruhige
 * Kopfzeile und der Inhalt. Mobil tritt die Seitenleiste zurück und eine
 * untere Leiste übernimmt die Navigation.
 */
import Base from './Base.astro';
import SkipLink from '@/components/shell/SkipLink.astro';
import ThemeToggle from '@/components/shell/ThemeToggle.astro';
import NotificationCenter from '@/components/shell/NotificationCenter.astro';
import InstallApp from '@/components/shell/InstallApp.astro';
import AutoUpdate from '@/components/shell/AutoUpdate.astro';
import LocaleSwitch from '@/components/shell/LocaleSwitch.astro';
import WorkspaceNav from '@/components/shell/WorkspaceNav.astro';
import MobileDock from '@/components/shell/MobileDock.astro';
import CommandPalette, { type PaletteItem } from '@/components/shell/CommandPalette.astro';
import AssistantPanel from '@/components/assistant/AssistantPanel.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import { serviceIcon } from '@/lib/icons';
import { favoritesOf } from '@/lib/store';
import { loadStatus, stateOf } from '@/lib/status';
import { useTranslations, type MessageKey } from '@/i18n';
import { isCurrent, WORKSPACE_NAV } from '@/lib/nav';
import { routeFrom, pathFor, type Locale, type RouteName } from '@/lib/locale';
import { text } from '@/lib/fleet';
import { articlesFor, articleSlug, canReadArticle } from '@/lib/knowledge';
import type { Session } from '@/lib/session';

interface Props {
  locale: Locale;
  session: Session;
  title: string;
  description: string;
}

const { locale, session, title, description } = Astro.props;
const t = useTranslations(locale);
const route = routeFrom(Astro.url.pathname);
const here = route.name;
const currentService =
  route.name === 'service' && route.param
    ? session.services.find((service) => service.id === route.param)
    : undefined;
const pageService = currentService
  ? { id: currentService.id, name: text(currentService.name, locale) }
  : null;
const currentItem = WORKSPACE_NAV.find((item) => isCurrent(item, here));
const identity = session.identity;
const initial = (identity?.name || identity?.username || 'U').charAt(0).toUpperCase();
const statusSnapshot = await Promise.race([
  loadStatus(session.services.map((service) => service.id)),
  new Promise<null>((resolve) => setTimeout(() => resolve(null), 300)),
]);
const stateLabel = (state: string): string =>
  state === 'up'
    ? t('stateUp')
    : state === 'down'
      ? t('stateDown')
      : state === 'unmonitored'
        ? t('stateUnmonitored')
        : t('stateUnknown');
const favoriteServices = identity
  ? favoritesOf(identity.username)
      .flatMap((id) => {
        const service = session.services.find((entry) => entry.id === id);
        if (!service) return [];
        const state = stateOf(service, statusSnapshot).state;
        return [{ service, state, stateText: stateLabel(state) }];
      })
      .slice(0, 3)
  : [];
const attentionCount = session.services.filter((service) => stateOf(service, statusSnapshot).state === 'down').length;
const suggestionsFor: Partial<Record<RouteName, readonly MessageKey[]>> = {
  overview: ['assistantSuggestOverview1', 'assistantSuggestOverview2', 'assistantSuggestOverview3'],
  services: ['assistantSuggestOverview1', 'assistantSuggestOverview2', 'assistantSuggestOverview3'],
  service: ['assistantSuggestService1', 'assistantSuggestService2', 'assistantSuggestService3'],
  knowledge: ['assistantSuggestKnowledge1', 'assistantSuggestKnowledge2', 'assistantSuggestKnowledge3'],
  article: ['assistantSuggestArticle1', 'assistantSuggestArticle2', 'assistantSuggestArticle3'],
  status: ['assistantSuggestStatus1', 'assistantSuggestStatus2', 'assistantSuggestStatus3'],
  account: ['assistantSuggestDefault1', 'assistantSuggestDefault2'],
  admin: ['assistantSuggestDefault1', 'assistantSuggestDefault2'],
};
const suggestions = (suggestionsFor[here] ?? ['assistantSuggestDefault1', 'assistantSuggestDefault2']).map((key) => t(key));

// Die Suche bekommt genau das, was diese Person sehen darf - serverseitig gebaut.
const prefix = locale === 'en' ? '/en' : '';
const articles = (await articlesFor(locale)).filter((article) => canReadArticle(article, session.identity));
const palette: PaletteItem[] = [
  ...WORKSPACE_NAV.filter((item) => !item.admin || session.isAdmin).map((item) => ({
    group: 'nav' as const,
    label: t(item.key),
    href: pathFor(locale, item.name),
  })),
  ...session.services.map((service) => ({
    group: 'services' as const,
    label: text(service.name, locale),
    hint: text(service.summary, locale),
    href: `${prefix}/services/${service.id}/`,
  })),
  ...articles.map((article) => ({
    group: 'knowledge' as const,
    label: article.data.title,
    hint: article.data.summary,
    href: `${prefix}/knowledge/${articleSlug(article)}/`,
  })),
];
---

<Base locale={locale} title={title} description={description} noindex>
  <SkipLink locale={locale} />

  <script is:inline>
    try {
      if (localStorage.getItem('vyrx-sidebar') === 'collapsed') document.documentElement.dataset.sidebar = 'collapsed';
    } catch {}
  </script>

  <div class="shell">
    <aside class="side">
      <div class="side__head">
        <a class="side__brand" href={pathFor(locale, 'overview')} aria-label={t('brandHome')}>
          <span class="side__brand-word"><Wordmark height="1.3rem" /></span>
          <span class="side__brand-mark" aria-hidden="true">V</span>
        </a>
        <button
          type="button"
          class="side__collapse"
          data-sidebar-toggle
          data-collapse-label={t('sidebarCollapse')}
          data-expand-label={t('sidebarExpand')}
          aria-label={t('sidebarCollapse')}
          aria-pressed="false"
          title={t('sidebarCollapse')}
        >
          <Icon name="arrowLeft" size="0.9rem" />
        </button>
      </div>

      <WorkspaceNav locale={locale} isAdmin={session.isAdmin} current={here} attentionCount={attentionCount} />

      {favoriteServices.length > 0 && (
        <section class="side__favorites" aria-labelledby="side-favorites-title">
          <p class="side__label" id="side-favorites-title">{t('sidebarYourServices')}</p>
          <ul>
            {favoriteServices.map((entry) => (
              <li>
                <a
                  class="side__favorite"
                  href={pathFor(locale, 'service', entry.service.id)}
                  aria-label={`${text(entry.service.name, locale)} · ${entry.stateText}`}
                  title={`${text(entry.service.name, locale)} · ${entry.stateText}`}
                >
                  <span class="side__dot" data-state={entry.state} aria-hidden="true" />
                  <Icon name={serviceIcon(entry.service.icon)} size="0.95rem" />
                  <span>{text(entry.service.name, locale)}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="side__all" href={pathFor(locale, 'services')}>
            {t('sidebarAllServices')}
            <Icon name="arrowRight" size="0.85rem" />
          </a>
        </section>
      )}

      <div class="side__bottom">
        <div class="side__account">
          <button
            type="button"
            class="side__user"
            data-user-menu-trigger
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="side-user-menu"
          >
            <span class="side__avatar" aria-hidden="true">{initial}</span>
            <span class="side__user-text">
              <strong>{identity?.name || identity?.username}</strong>
              <small>{t('personalSpace')}</small>
            </span>
            <Icon name="chevronRight" size="0.8rem" />
          </button>
          <div class="side__menu" id="side-user-menu" data-user-menu role="menu" hidden>
            <a class="side__menu-link" href={pathFor(locale, 'account')} role="menuitem">
              <Icon name="user" size="1rem" />
              {t('navAccount')}
            </a>
            <div class="side__menu-controls">
              <div class="side__menu-row">
                <span>{t('themeSwitch')}</span>
                <ThemeToggle locale={locale} />
              </div>
              <div class="side__menu-row">
                <span>{t('languageSwitch')}</span>
                <LocaleSwitch locale={locale} />
              </div>
            </div>
            <a class="side__menu-link" href="/outpost.goauthentik.io/sign_out" role="menuitem">
              <Icon name="lock" size="1rem" />
              {t('logout')}
            </a>
          </div>
        </div>
      </div>
    </aside>

    <div class="content">
      <header class="topbar">
        <a class="topbar__brand" href={pathFor(locale, 'overview')} aria-label={t('brandHome')}>
          <Wordmark height="1.15rem" />
        </a>
        <nav class="crumb" aria-label={t('workspaceLabel')}>
          <span>{t('workspaceLabel')}</span>
          <span aria-hidden="true">/</span>
          <strong>{currentItem ? t(currentItem.key) : t('navOverview')}</strong>
        </nav>
        <div class="topbar__actions">
          <span class="palette-slot"><CommandPalette locale={locale} items={palette} /></span>
          <InstallApp locale={locale} />
          <AutoUpdate />
          <NotificationCenter locale={locale} />
        </div>
      </header>

      <main id="main" tabindex="-1" class="main">
        <slot />
      </main>
    </div>
  </div>

  <MobileDock locale={locale} isAdmin={session.isAdmin} />
  <AssistantPanel
    locale={locale}
    name={identity?.name || identity?.username || ''}
    user={identity?.username || ''}
    pageService={pageService}
    suggestions={suggestions}
  />
</Base>

<script>
  const menuTrigger = document.querySelector<HTMLButtonElement>('[data-user-menu-trigger]');
  const userMenu = document.querySelector<HTMLElement>('[data-user-menu]');

  const menuItems = (): HTMLElement[] =>
    userMenu
      ? [...userMenu.querySelectorAll<HTMLElement>('a, button:not([disabled])')]
      : [];

  const closeMenu = (restoreFocus = true): void => {
    if (!userMenu || !menuTrigger || userMenu.hidden) return;
    userMenu.hidden = true;
    menuTrigger.setAttribute('aria-expanded', 'false');
    if (restoreFocus) menuTrigger.focus();
  };

  const openMenu = (): void => {
    if (!userMenu || !menuTrigger || !userMenu.hidden) return;
    userMenu.hidden = false;
    menuTrigger.setAttribute('aria-expanded', 'true');
    window.requestAnimationFrame(() => menuItems()[0]?.focus());
  };

  menuTrigger?.addEventListener('click', (event) => {
    if (!userMenu) return;
    event.stopPropagation();
    if (userMenu.hidden) openMenu();
    else closeMenu();
  });

  userMenu?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return;
    const items = menuItems();
    if (items.length === 0) return;
    event.preventDefault();
    const index = items.indexOf(document.activeElement as HTMLElement);
    const next =
      event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? items.length - 1
          : event.key === 'ArrowDown'
            ? (index + 1 + items.length) % items.length
            : (index - 1 + items.length) % items.length;
    items[next]?.focus();
  });

  document.addEventListener('pointerdown', (event) => {
    if (!userMenu || userMenu.hidden) return;
    const target = event.target as Node | null;
    if (target && (userMenu.contains(target) || menuTrigger?.contains(target))) return;
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  userMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));

  const sidebarToggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
  const root = document.documentElement;

  const reflectSidebar = (): void => {
    if (!sidebarToggle) return;
    const collapsed = root.dataset.sidebar === 'collapsed';
    sidebarToggle.setAttribute('aria-pressed', String(collapsed));
    sidebarToggle.setAttribute(
      'aria-label',
      sidebarToggle.dataset[collapsed ? 'expandLabel' : 'collapseLabel'] ?? '',
    );
    sidebarToggle.title = sidebarToggle.getAttribute('aria-label') ?? '';
  };

  sidebarToggle?.addEventListener('click', () => {
    const collapsed = root.dataset.sidebar !== 'collapsed';
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    try {
      localStorage.setItem('vyrx-sidebar', collapsed ? 'collapsed' : 'expanded');
    } catch {
      // Kein Speicher: die Wahl gilt für diese Seite.
    }
    reflectSidebar();
  });

  reflectSidebar();
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    min-height: 100dvh;
    transition: grid-template-columns var(--fast) var(--ease);
  }

  .side {
    position: sticky;
    transition: padding var(--fast) var(--ease);
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--space-8) var(--space-4) var(--space-6);
    background: var(--panel);
    color: var(--panel-ink);
  }

  .side__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-1) var(--space-4) var(--space-10);
  }

  .side__brand {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--panel-on);
  }

  .side__brand-word {
    display: block;
  }

  .side__brand-mark {
    display: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-sm);
    color: var(--panel-on);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .side__collapse {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-inline-start: auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--panel-faint);
  }

  .side__collapse:hover {
    border-color: var(--panel-line);
    background: var(--panel-hover);
    color: var(--panel-on);
  }

  .side__favorites {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--panel-line);
  }

  .side__favorites ul {
    display: grid;
    gap: 1px;
    list-style: none;
  }

  .side__favorite {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--panel-muted);
    font-size: var(--text-sm);
  }

  .side__favorite:hover {
    background: var(--panel-hover);
    color: var(--panel-on);
  }

  .side__favorite > span:last-of-type {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .side__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--panel-faint);
  }

  .side__dot[data-state='up'] { background: var(--panel-dot-up); }
  .side__dot[data-state='down'] {
    border: 1.5px solid var(--panel-dot-down);
    background: transparent;
  }
  .side__dot[data-state='unknown'] {
    border-radius: 1px;
    background: var(--panel-dot-unknown);
    transform: rotate(45deg);
  }
  .side__dot[data-state='unmonitored'] {
    border: 1px solid var(--panel-dot-muted);
    background: transparent;
  }

  .side__all {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) var(--space-4) 0;
    color: var(--panel-faint);
    font-size: var(--text-xs);
  }

  .side__all:hover {
    color: var(--panel-on);
  }

  .side__account {
    position: relative;
  }

  .side__user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
  }

  .side__user:hover,
  .side__user[aria-expanded='true'] {
    background: var(--panel-hover);
  }

  .side__user > :global(svg) {
    margin-inline-start: auto;
    color: var(--panel-faint);
    transition: transform var(--fast) var(--ease);
  }

  .side__user[aria-expanded='true'] > :global(svg) {
    transform: rotate(90deg);
  }

  .side__user:focus-visible,
  .side__collapse:focus-visible,
  .side__favorite:focus-visible,
  .side__all:focus-visible,
  .side__menu-link:focus-visible,
  .side__menu :global(.theme-toggle):focus-visible,
  .side__menu :global(.locale__item):focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .side__menu {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% + var(--space-2));
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-md);
    background: var(--panel-surface);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.3);
  }

  .side__menu[hidden] {
    display: none;
  }

  .side__menu-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--panel-ink);
    font-size: var(--text-sm);
  }

  .side__menu-link:hover {
    background: var(--panel-hover);
    color: var(--panel-on);
  }

  .side__menu-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    margin-block: 2px;
    border-block: 1px solid var(--panel-line);
  }

  .side__menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-inline: 0.6rem;
    color: var(--panel-faint);
    font-size: var(--text-xs);
  }

  .side__menu :global(.theme-toggle),
  .side__menu :global(.locale) {
    border-color: var(--panel-line);
    background: var(--panel-surface-2);
  }

  .side__menu :global(.theme-toggle) {
    width: 1.9rem;
    height: 1.9rem;
    color: var(--panel-muted);
  }

  .side__menu :global(.locale__item) {
    padding: 0.35rem 0.45rem;
    color: var(--panel-muted);
  }

  .side__menu :global(.locale__item + .locale__item) {
    border-left-color: var(--panel-line);
  }

  .side__menu :global(.locale__item.is-current) {
    background: var(--panel-active);
    color: var(--panel-on);
  }

  .side__label {
    margin: 0 var(--space-4) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--panel-faint);
  }

  .side__bottom {
    margin-top: auto;
    border-top: 1px solid var(--panel-line);
    padding-top: var(--space-5);
  }

  .side__user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .side__avatar {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-sm);
    background: var(--panel-surface);
    color: var(--panel-ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    flex: none;
  }

  .side__user-text strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .side__user-text small {
    display: block;
    color: var(--panel-faint);
    font-size: var(--text-xs);
    margin-top: 1px;
  }

  .side__logout {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: var(--panel-muted);
    font-size: var(--text-sm);
  }

  .side__logout:hover {
    color: var(--panel-on);
  }

  .content {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 70px;
    padding-inline: clamp(var(--space-4), 4vw, var(--space-12));
    background: color-mix(in srgb, var(--surface-2) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .topbar__brand {
    display: none;
    color: var(--ink);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .crumb strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  .topbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .palette-slot {
    display: contents;
  }

  @media (min-width: 901px) {
    .palette-slot {
      display: block;
    }
  }

  @media (max-width: 900px) {
    .palette-slot :global(.trigger) {
      display: none;
    }
  }

  .main {
    flex: 1;
    padding: var(--space-12) clamp(var(--space-4), 4vw, var(--space-12)) var(--space-24);
  }

  :global(html[data-sidebar='collapsed']) .shell {
    grid-template-columns: 76px minmax(0, 1fr);
  }

  :global(html[data-sidebar='collapsed']) .side {
    align-items: center;
    padding-inline: 8px;
  }

  :global(html[data-sidebar='collapsed']) .side__head {
    flex-direction: column;
    gap: var(--space-3);
    margin-inline: 0;
  }

  :global(html[data-sidebar='collapsed']) .side__brand-word {
    display: none;
  }

  :global(html[data-sidebar='collapsed']) .side__brand-mark {
    display: grid;
  }

  :global(html[data-sidebar='collapsed']) .side__collapse {
    margin-inline-start: 0;
  }

  :global(html[data-sidebar='collapsed']) .side__collapse :global(svg) {
    transform: rotate(180deg);
  }

  :global(html[data-sidebar='collapsed']) .side__label,
  :global(html[data-sidebar='collapsed']) .side__favorites {
    display: none;
  }

  :global(html[data-sidebar='collapsed']) .side :global(.ws-nav) {
    width: 100%;
  }

  :global(html[data-sidebar='collapsed']) .side :global(.ws-nav__item) {
    justify-content: center;
    padding-inline: 0;
  }

  :global(html[data-sidebar='collapsed']) .side :global(.ws-nav__item > span:not(.ws-nav__badge)) {
    display: none;
  }

  :global(html[data-sidebar='collapsed']) .side :global(.ws-nav__badge) {
    position: absolute;
    top: 3px;
    right: 3px;
    min-width: 0.9rem;
    height: 0.9rem;
    padding-inline: 0.2rem;
    font-size: 0.5rem;
  }

  :global(html[data-sidebar='collapsed']) .side__bottom {
