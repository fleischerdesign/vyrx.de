# Wie die App ihre Daten findet. Im Betrieb setzt die Bereitstellung diese Werte;
# lokal genügt das Fixture.

# Die Projektion aus nixfiles (Pfad zu einer JSON-Datei).
PORTAL_FLEET=fixtures/fleet.example.json

# Der Kollektor für gemessenen Zustand. Fehlt er, ist der Zustand "unbekannt".
PORTAL_PROMETHEUS_URL=http://127.0.0.1:9090

# Nur für die Entwicklung: eine Identität vortäuschen, damit Ansichten ohne
# Authentik prüfbar sind. Im Betrieb leer - dann zählt der Proxy-Header.
PORTAL_DEV_USER=
PORTAL_DEV_NAME=
PORTAL_DEV_GROUPS=
